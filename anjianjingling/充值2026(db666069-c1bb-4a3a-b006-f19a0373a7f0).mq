Function 取消续费()
    Dim deleteRound,flowTry,navigationOk
    navigationOk = False

    ' 支付宝导航任一环节失败，都从首页完整重来，不在错误页面继续固定坐标点击
    For flowTry = 1 To 3
        RunApp zfb
        Delay 1000
        If 等待任一图片(110,64,419,327,"支付宝页面",8,200,"取消续费-支付宝首页") = 1 Then
            Tap 642,1222
            Delay 800
            If 等待并点击图片(569,44,717,157,"zfb设置",0,0,15,100,1000,"取消续费-设置") = 1 Then
                Tap 110,460
                Delay 1200
                Tap 230,385
                Delay 800
                If 等待并点击图片(15,514,593,1265,"zfb续费图标",0,0,15,120,1000,"取消续费-续费入口") = 1 Then
                    If 等待并点击图片(67,138,595,389,"zfb续费图标",0,0,15,120,500,"取消续费-服务列表") = 1 Then
                        navigationOk = True
                        Exit For
                    End If
                End If
            End If
        End If
        等待状态回传 "取消续费-导航", "第" & flowTry & "次导航失败，从支付宝首页重试"
        执行等待恢复 "重启支付宝"
    Next
    If navigationOk = False Then 等待致命失败 "取消续费-导航", "支付宝页面|zfb设置|zfb续费图标"

    ' 最多处理10个可关闭项目；只有确认管理按钮消失才视为完成
    For deleteRound = 1 To 10
        If 等待任一图片(559,456,707,561,"zfb管理",5,150,"取消续费-管理按钮") = 0 Then Exit For
        Tap x,y
        Delay 300
        必须点击图片 0,0,0,0,"zfb关闭",0,0,10,150,300,1,"无","取消续费-关闭服务"
        必须点击图片 0,0,0,0,"zfb确认关闭",0,0,10,150,1800,1,"无","取消续费-确认关闭"

        If 等待并点击图片(536,719,719,866,"zfb管理",0,0,4,150,300,"取消续费-第二管理按钮") = 1 Then
            必须点击图片 0,0,0,0,"zfb关闭",0,0,10,150,300,1,"无","取消续费-第二关闭服务"
            必须点击图片 0,0,0,0,"zfb确认关闭",0,0,10,150,1800,1,"无","取消续费-第二确认关闭"
        End If
    Next

    If 等待任一图片(559,456,707,561,"zfb管理",3,150,"取消续费-完成确认") = 1 Then 等待致命失败 "取消续费-完成确认", "zfb管理"
    TracePrint "支付宝续费项目已处理完成"
    run code
End Function
Function 推荐页到个人信息()
    
    If tj = "首次" Then 
        TracePrint "跳过找账户中心"
        
        goto 首次启动
    End If 
    RunApp kg
    Delay 1000
    For 1
        Call 找图(0,0,0,0, "账号中心")
        If x > 0 Then 
            TracePrint "在账户中心界面"
            KeyPress "back"
            Delay 800
            TracePrint "个人信息"
            Tap 335, 340
            Delay 1000
            Exit Function
        Else 
            TracePrint "没在账户中心"
            KeyPress "back"
            关闭广告 
        End If
        找图 0, 0, 0, 0, "我的会员"
        If x > 0 Then 
            TracePrint "在账户中心界面"
            Exit Function
        Else 
            TracePrint "没在账户中心"
        End If
    	
    next
    找图(1,52,147,153,"推荐")
    If x>0 Then 
        TracePrint "在推荐页"
        Delay 500
        TracePrint "点三条杠"
        tap 676,105
        goto 在推荐页
    Else 
        TracePrint "没找到推荐"
    End If
    临时=xdpub.元素查找({"resource-id":"com.kugou.android:id/a42"})
    If 临时 Then 
        TracePrint "在推荐页"
        Delay 500
        TracePrint "点三条杠"
        tap 676,105
        goto 在推荐页
    Else 
        TracePrint "没找到推荐"
    End If
    关闭广告 
    Rem 回到推荐页
    KillApp kg
    Delay 1500
    runapp kg
    Delay 2000
    关闭广告
    TracePrint "循环找推荐页"
    Rem 首次启动
    do
        For 8
            找图(1,52,147,153,"推荐")
            If x>0 Then 
                TracePrint "在推荐页"
                Delay 800
                TracePrint "点三条杠"
                Tap 676, 105
                Delay 500
                Exit do
            Else 
                TracePrint "没找到推荐"
                关闭广告 
                
            End If
            临时=xdpub.元素查找({"resource-id":"com.kugou.android:id/a42"})
            If 临时 Then 
                TracePrint "在推荐页"
                Delay 500
                TracePrint "点三条杠"
                tap 676,105
                Exit do
            Else 
                TracePrint "没找到推荐"
            End If
            会员活动广告
        Next
        
        Delay 100
        goto 回到推荐页
    loop    
    
    rem 在推荐页
    Delay 500
    For 5
        临时=xdpub.元素查找({"resource-id":"com.kugou.android:id/ea_","text":"设置"})
        If 临时 Then
