        TracePrint uget
        
        If uget = "" Then
            TracePrint "任务接口暂无数据"
            Delay 2680
        Else
            a = Split(uget, ",")
            If UBound(a) >= 13 Then
                TracePrint "任务数据有效"
                Exit Do
            Else
                TracePrint "任务数据字段不足，忽略本次返回：" & uget
                Delay 1000
            End If
        End If
    Next
    
    Delay 500
Loop

