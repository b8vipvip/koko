            If 返回条件 = 1 Then ShowMessage "取消：取消修正":Exit Function
        End Select
        cjc = p
        Exit Function           
    ElseIf t = "hhzk3"  Then 
        p=hhzkp
        TracePrint "修正hhzkp"
        TracePrint "修正前p:"&p
        
        p = Encode.TableToJson(p)
        a=UBound(p)+1
        If Len(p) >= 3 Then
            If Mid(p, 2, 1) = "1" Then
                TracePrint "修正小数点"
                p = Left(p, 1) & "." & Mid(p, 3,3)
            ElseIf Mid(p, 3, 1) = "1" Then
                TracePrint "修正小数点"
                p = Left(p, 2) & "." & Mid(p, 4, 3)
            End If
            If Mid(p, a, 1) = "1" Then
                TracePrint "修正最后一位数字1"
                p = Left(p, a - 1)
            End If
        End If
        If p = "268" Then
            p = "26.8"
        elseIf p = "260" Then
            p = "26.8"
        elseIf p = 260 Then
            p = 26.8
        End If
        p = CDbl(p)
        hhzkp = p
        TracePrint "修正后p:"&p
        Select Case p
        Case 18,20,22,26.8,24,30,39,45,180
            TracePrint "金额正确"
            TracePrint p
            
        Case Else
            TracePrint "金额不正确,需要人工核对"
            email= "卡了，hhzk3金额不正确,需要人工核对"&",修正后p:"&p&",修正前:"&hhzkp&",ocr8:"&ocr8&",socr8:"&socr8
            status id, "卡了", 1, email
            返回条件 = Dialog.MsgBox("金额不对\n识别到的金额为:"&p&"\n确定：继续脚本；取消：手动确认后回home",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定：继续脚本":Exit Function
            If 返回条件 = 1 Then ShowMessage "取消：取消修正":Exit Function
        End Select
        hhzkp = p
        Exit Function
    ElseIf t = "wpcj1"  Then 
        p=wpcj1
        TracePrint "修正wpcj1"
        TracePrint "修正前p:"&p
        
        p = Encode.TableToJson(p)
        a=UBound(p)+1
        If Len(p) >= 3 Then
            If Mid(p, 2, 1) = "1" Then
                TracePrint "修正小数点"
                p = Left(p, 1) & "." & Mid(p, 3,3)
            ElseIf Mid(p, 3, 1) = "1" Then
                TracePrint "修正小数点"
                p = Left(p, 2) & "." & Mid(p, 4, 3)
            End If
            If Mid(p, a, 1) = "1" Then
                TracePrint "修正最后一位数字1"
                p = Left(p, a - 1)
            End If
        End If
        If p = 18 Then
            p = 13
        ElseIf p = "18" Then
            p = "13"   
        End If
        p = CDbl(p)
        wpcj1 = p
        TracePrint "修正后p:"&p
        Select Case p
        Case 10.5,0.88,1,1.8,1.88,2,2.8,3,3.8,3.9,4,4.8,5,5.7,6,6.8,7,7.5,8.7,8,9,9.9,10,10.8,11,12,14,13,15
            TracePrint "金额正确"
            TracePrint p
            
        Case Else
            TracePrint "金额不正确,需要人工核对"
            email= "卡了，wpcj1金额不正确,需要人工核对"&",修正后p:"&p&",修正前:"&wpcj1&",ocr8:"&ocr8&",socr8:"&socr8
            status id, "卡了", 1, email
            返回条件 = Dialog.MsgBox("金额不对\n识别到的金额为:"&p&"\n确定：继续脚本；取消：手动确认后回home",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定：继续脚本":Exit Function
            If 返回条件 = 1 Then ShowMessage "取消：取消修正":Exit Function
        End Select
        wpcj1 = p
        Exit Function    
    Else 
        Exit Function
    End If
    必须等待界面 0,0,0,0,"home",10,100,3,"回桌面","金额修正-等待桌面"
End Function

