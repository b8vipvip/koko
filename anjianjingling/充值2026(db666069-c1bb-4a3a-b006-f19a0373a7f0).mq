Function 超级升级充值(月数)   
    Delay 1000
    Rem 重启酷狗
    Rem 重新打开vip
    RunApp kg
    Delay 1000
    for 3
        找图 0,0,0,0, "升级弹窗"	
        If x>0 Then 
            TracePrint "直达升级"
            Tap 370,831
            Delay 1500
            sjp = 555
            Goto 直达升级
        End If
        Delay 300
    next
    找图 0, 0, 0, 0, "确认协议"
    If x > 0 Then 
        TracePrint "在豪华确认协议"
        KeyPress "Back"
        Delay 1000
        Tap 145, 88
        Delay 1500
        goto 找礼物
    End If
    Call 找图(17,1161,116,1263, "礼物图标")
    If x > 0 Then 
        TracePrint "进入会员界面"
        KeyPress "Back"
        Delay 1000
        Tap 511,1208
        Delay 2000
        Tap 146,90
        goto 找礼物
                
    End If
    TracePrint "到价格界面"
    找图 16, 139, 582, 518, "超级会员界面"
    If x > 0 Then 
        TracePrint "进入超级会员界面"
        Goto 点开通
    End If
    找图 0, 0, 0, 0, "超级50加"
            
    If x>0 Then 
        TracePrint "进入超级会员界面"
        Goto 点开通
    End If
    
    
    
    FindPic 0,0,0,0, "Attachment:超级50加.png", "000000", 0, 0.9, x, y
    If x > 0 Then 
        TracePrint "进入豪华会员界面"
        Goto 点开通
    End If
     
    找图 0, 0, 0, 0, "超级界面超级VIP"
            
    If x>0 Then 
        TracePrint "进入超级会员界面"
        Goto 点开通
    End If
    For 3
        找图 0,0,0,0, "我的会员"
        If x > 0 Then 
            Tap x, y
            Delay 2000
            goto 找礼物
        End If
    Next
    for 5
        找图 0,0,0,0, "升级弹窗"	
        If x>0 Then 
            TracePrint "直达升级"
            Tap 370,831
            Delay 1500
            sjp = 555
            Goto 直达升级
        End If
        Delay 300
    Next
    for 2
        runapp "com.kugou.android","com.kugou.android.useraccount.vippage.VIPInfoChildActivity"
        Delay 3500 
        For 5
            找图 0,0,0,0, "礼物图标"
            If x > 0 Then 
                Tap 146, 90
                Delay 500
                goto 找礼物
            End If
            Delay 300
        Next
        KillApp kg
        Delay 500
        RunApp kg
        Delay 1500
    next	
    tj = "二次"
    推荐页到个人信息 
    Rem 找礼物
    do
        For 5
            '是否在超级会员界面
            找图 0, 0, 0, 0, "超级50加"
            
            If x>0 Then 
                TracePrint "进入超级会员界面"
                Exit do
            End If
            FindPic 0,0,0,0, "Attachment:超级50加.png", "000000", 0, 0.9, x, y
            If x > 0 Then 
                TracePrint "进入豪华会员界面"
                Exit do
            End If
            找图 16, 139, 582, 518, "超级会员界面"
            If x > 0 Then 
                TracePrint "进入超级会员界面"
                Exit Do
            End If
            找图 0,0,0,0,"超级界面超级VIP"
            If x>0 Then 
                TracePrint "进入超级会员界面"
                Exit do
            End If
            找图 0,0,0,0,"豪华界面超级VIP"
            If x>0 Then 
                TracePrint "进入超级会员界面"
                Tap x+20,y+20
            End If
            找图(17,1161,116,1263, "礼物图标")
            If x > 0 Then 
                TracePrint "进入会员界面"
                Delay 500
                TracePrint "点超级会员"
                Tap 138,89'点超级vip
                Delay 1000
            End If
            找图 0,0,0,0, "我的会员"
            If x > 0 Then 
                Tap x, y
                Delay 2000
            End If
            找图(0,0,0,0,"超级确认协议")
            If x > 0 Then 
                Delay 500
                goto 进超级价格
            End If
            Delay 100
        Next
        goto 重新打开vip
    Loop
    '点开通
    Rem 点开通
    Tap 575, 421
    Delay 1500
    do
        For 15
            找图(0,0,0,0,"超级确认协议")
            If x > 0 Then 
                Delay 500
                Exit do
            End If
            Delay 100
        Next
        KillApp "com.kugou.android"
        Delay 1500
        RunApp kg
        Delay 2500
        Goto 重启酷狗
    Loop
    rem 进超级价格
    do
        If 月数 = 0.5 Then 
            For 15
                找图(0,0,0,0,"超级升级")
                If x > 0 Then 
                    tap x,y
                    Delay 500
                    goto 开通
                    Exit do
                End If
                Delay 100
            Next
        End If
        For 15
            找图(0,0,0,0,"app升级")
            If x > 0 Then 
                tap x,y
                Delay 500
                //tap x+68,y+139
                Exit do
            End If
            Delay 100
        Next
        找图(0,0,0,0,"超级升级30天")
        If x > 0 Then 
            tap x,y
            Delay 500
            TracePrint "找到30天升级"
            goto 升级30天
            Exit do
        End If
        找图(0,0,0,0,"0元7天超级")
        If x > 0 Then 
            sjp = 2
            超级升级 (1)
            Exit Function
        End If
        If cs1次 = "1次" Then 
            email= "[找了15次，没找到2元升级]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
            status id, "卡了", 2, email	
        End If

        KeyPress "back"
        Delay 1500
        dim cs1次="1次"
        Goto 点开通
    Loop
    do
        for 2
            提取文本 "android.widget.TextView", "", 50, 1155, "", 1224,"num","yes"
            If 识别 <> False and text1<>"" Then 
                ocr8 = CDbl(text1)
                TracePrint ocr8
                If ocr8 = 1 and 月数=1 Then 
                    sjp = 1
                    Exit do
                ElseIf ocr8 = 2 Then
                    sjp = 2
                    Exit do
                ElseIf ocr8 >= 5 and sjpx<>2 and 月数=1 and cjsj<>1 Then
                    sjp = 2
                    超级升级 (1)
                    Exit Function
                ElseIf ocr8 >= 5 and sjpx=2 and 月数=1 Then
                    sjp = 5
                    Exit do
                ElseIf 月数>1 Then
                    Exit do
                End If
                TracePrint "不满足条件"
                Exit do    
            Else 
                TracePrint "无元素"
                //                email= "[没找到升级价格]["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]"&"[sj30:"&sj30&"]"&"[hhsj1:"&hhsj1&"]"&"[jyq:"&jyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
                //                status id, "无元素", 2, email
            End If
            Delay 500
        Next
        goto 重新打开vip 
    loop
    TracePrint "点升级月数"
    
    do 
        找图(0,0,0,0,"app升级")
        If x > 0 Then 
            tap x+68,y+139
            Exit do
        End If
        Delay 200
    loop
    do
        For 5
            找图(104,744,581,1092,"升级月份")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出升级月份"
                Exit do
            End If
            Delay 100
        Next
        Delay 100
    Loop
    
    For 15
        识别数字(319, 1015, 408, 1076, "识别到当前月份为：")
        TracePrint xname
        If xname > 月数 Then 
            TracePrint "减一个月"
            Tap 119, 1044
            Delay 500
        ElseIf xname < 月数 Then
            Tap 602, 1040
            Delay 500
            TracePrint "减一个月"
        ElseIf xname = 月数 Then
            TracePrint "月份正确，退出循环" 
            Exit For
        End If	
    Next
    TracePrint "月份正确，直接点升级" 
    
    
    goto 开通
    Rem 升级30天
    If 月数 = 1 Then 
            
        Do
            For 2
                FindColor 23,1190,300,1192,"626262|848484|888888",0,1,x, y
                If x > 0 Then 
                    TracePrint x&","&y 
                    TracePrint "识别价格区域"
                    Exit do
                End If
                Delay 200
            Next
            TracePrint "没找到识别价格区域"
        Loop
        ocr8 = Image.OcrText(51, 1164, x - 5, 1222, 0, 0)
        TracePrint ocr8
        If IsNumeric(ocr8) = true Then 
            cj1 = CDbl(Abs(ocr8))	
            TracePrint "cj1价格text:" &cj1
     
        Else
            ocr8 = SmartOcr(51, 1164, x - 5, 1222)
            TracePrint "smartocr"&ocr8
            If IsNumeric(ocr8) = true Then 
                cj1 = CDbl(Abs(ocr8))	
                TracePrint "cj1价格smart:" &cj1
            
            Else 
                cj1 = 200
                TracePrint "识别出错，自定义cj1价格:" &cj1
            End If
        End If
        sjp=cj1
        If (cj1 + zfbp < xpx) = true and cj1<= 5.7 Then 
            TracePrint "升级30小于订单金额，可升级"
            
            goto 开通
        End If
   
    Else 
        email= "[充值失败，到一半，找不到2元升级，且可以30天升级一次，但是需要升级的月数大于1]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
        
        status id, "卡了", 2, email
        TracePrint "充值到一半"
        返回条件 = Dialog.MsgBox("充值到一半\n\n确定：继续开通；取消：结束脚本",1)
        TracePrint 返回条件
        If 返回条件 = 0 Then ShowMessage "确定，继续支付"
        If 返回条件 = 1 Then ShowMessage "取消支付，结束脚本":ExitScript
        
    End If
   
    rem 开通
    Tap 333, 1176
    do
        For 5
            找图(134,761,608,934,"继续购买")
            If x > 0 Then 
