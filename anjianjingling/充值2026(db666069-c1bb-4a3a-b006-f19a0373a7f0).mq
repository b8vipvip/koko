            TracePrint "找到九元无资格4"
           
            jyq="无券"
            Exit Function  
                  
        End If
        Delay 200
    Loop
    //点立即开通
    tap 540,675
    Delay 200

    Do    
        For 15
            找图(0,0,0,0,"via9元跳转允许")
            If x>0 Then  
                TracePrint "via9元跳转允许"
                Tap x+30,y+20
                Delay 1500
                Exit Do
            End If
            Delay 100
        Next
        tap 540,675
        Delay 200
    Loop
    do
        For 10
            找图 0, 0, 0, 0, "app秒杀券"
        
            If x > 0 Then 
                TracePrint "找到app界面"
                Exit Do          
            End If
            找图 0,0,0,0, "via9元券"
