                    tap tx,ty
                    Delay 300
                End If
                Delay 200
            Next
        Loop
        Delay 1000
        Touch 150, 98, 1000
        Do
            For 10
                找图 0,0,0,0, "via复制"
                TracePrint tx&","&ty
                If find=True Then 
                    TracePrint "via复制"
                    Delay 2000
                    TracePrint tx&","&ty
                    Tap tx+28,ty+18
                    TracePrint "8"
                    Exit Do
                End If
                Delay 200	
            Next
            Touch 150, 98, 1000
        Loop
        Delay 1000
        pay(i)= Sys.GetClipText()
        
        TracePrint pay(i)
        Delay 1000
        '① 必须包含 out_trade_no
        If InStr(1, pay(i), "out_trade_no") < 1 Then
            TracePrint "第" & i & "条无效：不包含 out_trade_no"
            Exit Function
        End If

        '② 提取订单号
        当前订单号 = 提取订单号(pay(i))

        '③ 判断订单号是否有效
        If 当前订单号 = "" Then
            TracePrint "第" & i & "条无效：订单号为空或提取失败"
            Exit Function
        End If

        If Len(当前订单号) < 10 Then
            TracePrint "第" & i & "条无效：订单号长度异常：" & 当前订单号
            Exit Function
        End If

        orderNo(i) = 当前订单号
        TracePrint "第" & i & "条订单号：" & orderNo(i)

        '④ 判断当前订单号是否和前面重复
        For j = 1 To i - 1
            If orderNo(i) = orderNo(j) Then
                TracePrint "第" & i & "条订单号与第" & j & "条重复：" & orderNo(i)
                Exit Function
            End If
        Next

        TracePrint "第" & i & "条订单号有效且不重复"
    Next
    领3天券 
