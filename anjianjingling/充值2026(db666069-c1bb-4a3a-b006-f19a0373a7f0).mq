            zm.OpenURL url_vip
        
            Delay 2500
        Loop

        Do
            For 5
            		
                找图 0,0,0,0,"via豪华超级VIP"
                If find=true Then 
                    TracePrint "web有超级"
                    wpcj=1
                    截图("价格页面")
                    Exit Do
                End If
                Delay 200
                找图 0,0,0,0,"web超级2"
                If find=true Then 
                    TracePrint "web有超级"
                    wpcj=1
                    截图("价格页面")
                    Exit Do
                End If
                Delay 200
            Next
                
        Loop
		Do
        	For 10
            	
            	Call 找图(10,402,233,815, "via米月")
            	If find=true Then   
                	Exit Do
            	End If
            	Delay 200
            	Call 找图(10,402,233,815, "via米月2")
            	If find=true Then 
                	Exit Do
            	End If
            	Delay 200
            	找图 0,0,0,0,"via米月1"
            	If find=true Then 
                	TracePrint "web米超级"
                	Exit Do
            	End If
            	Delay 200
            	找图 0,0,0,0,"via米-超级豪华"
            	If find=true Then 
                	TracePrint "web米超级"
                	Exit Do
            	End If
            	Delay 200
            	找图 0,0,0,0,"via米-超级豪华1"
            	If find=true Then 
                	TracePrint "web米超级"
                	Exit Do
            	End If
            	Delay 200
        	Next
    	
        	TracePrint "不在价格页面" 
        	Delay 100
        	zm.OpenURL url_vip
        	Delay 2000
        	Do
            	For 5
                	找图 0,0,0,0,"via豪华超级VIP"
                	If find=true Then 
                    	TracePrint "web有超级"
                    	wpcj=1
                    	截图("价格页面")
                    	Exit Do
                	End If
                	Delay 200
                	找图 0,0,0,0,"web超级2"
                	If find=true Then 
                    	TracePrint "web有超级"
                    	wpcj=1
                    	截图("价格页面")
                    	Exit Do
                	End If
                	Delay 200
            	Next
            	zm.OpenURL url_vip
        		Delay 2000
        	Loop
    	Loop
        Tap tx, ty
        '是否首月或新客
        ai识图 tx-83,ty-134,tx+121,ty+128, "识别图中文本是否包含(新客专享)或(首月特惠)，如果是返回1，不是返回2"
        If CDbl(ret)=2 Then 
            TracePrint "非首月或新客，继续"
        Else 
            返回条件 = Dialog.MsgBox("首月或新客\n\n确定：继续；取消：结束脚本",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定，继续":Delay 5000
            If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
	
        End If 
        '核对价格
        Delay 800
//        ai识图 tx, ty - 30, tx + 115, ty + 45, "图中只包含一个价格,识别图中价格,价格可能为整数或包含2位小数(例如：13、1.88、7.5),并只返回这个价格的数值,如果无法识别则返回0"
        ocr8 = Image.OcrText(tx + 21, ty - 30, tx + 115, ty + 45, 0, 0)
    	TracePrint ocr8
    	ocr8 = SmartOcr(tx + 21, ty - 30, tx + 115, ty + 45)
    	TracePrint ocr8   
    	If IsNumeric(Image.OcrText(tx + 21, ty-30, tx+115, ty+45, 0, 0)) = true Then 
        	ocr8 = CDbl(Abs(Image.OcrText(tx + 21, ty-30, tx+115, ty+45, 0, 0)))	
        	TracePrint "wp1价格text:" &ocr8
        	修正金额("wp1")
    	Else  
        	TracePrint smartocr(tx + 21, ty-30, tx+115, ty+45)
        	If IsNumeric(SmartOcr(tx + 21, ty-30, tx+115, ty+45)) = true Then 
            	ocr8 = CDbl(Abs(SmartOcr(tx + 21, ty-30, tx+115, ty+45)))	
            	TracePrint "wp1价格smart:" &ocr8
            	修正金额("wp1")
        	Else 
            	ocr8 = 200
            	TracePrint "识别出错，自定义wp1价格:" &ocr8
        	End If
    	End If
        If CDbl(wpcj1) = CDbl(ocr8) Then 
            TracePrint "价格正确，继续"
        Else 
            返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续；取消：结束脚本",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定，继续":Delay 5000
            If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
	
        End If 
        Do
            找图 0,0,0,0, "via同意续费"
            If find=true Then 
                tap x+28,y+16        
            End If
            Delay 200
            找图 0,0,0,0, "via同意续费已勾选"
            If find=True Then    
                Exit Do          
            End If
        Loop
        Delay 300
        tap 508,1088'点豪华确认协议
        Delay 500
        Do
            For 5
                找图 0,0,0,0, "via支付宝"
                If find=True Then 
                    TracePrint "选择支付宝"
                    Delay 500
                    Tap 79, 966
                    TracePrint "点击"
                    Delay 300
                    Exit do
                End If
                Delay 200
                找图 0,0,0,0, "via继续购买"
                If find=True Then 
                    TracePrint "选择支付宝"
                    tap tx,ty
                    Delay 300
                
                End If
                找图 0,0,0,0, "web开通"
                If find=True Then 
               
                    tap tx,ty
                    Delay 1000
                End If
                找色 8, 727, 119, 851, "D89235|D9953A"
                If find=True Then 
                    TracePrint "续费选项弹出"
                    Tap 94, 771
                    Delay 300
                End If
                Delay 100
            Next
            Delay 100
        loop
        Delay 1000
        Do    
            For 10
                找图 0, 0, 0, 0, "via打开支付宝"
                If find=True Then  
                    TracePrint "via打开支付宝"
                    Delay 200
                    Exit Do
                End If
                Delay 200
                找图 0,0,0,0, "via支付宝"
                If find=True Then 
                    TracePrint "选择支付宝"
                    Delay 500
                    tap tx,ty
                    Delay 300
                End If
                Delay 200
            Next
        Loop
        Delay 1000
        Touch 150, 98, 1000
        Do
            For 10
                找图 0,0,0,0, "via复制"
                TracePrint tx&","&ty
                If find=True Then 
                    TracePrint "via复制"
                    Delay 2000
                    TracePrint tx&","&ty
                    Tap tx+28,ty+18
                    TracePrint "8"
                    Exit Do
                End If
                Delay 200	
            Next
            Touch 150, 98, 1000
        Loop
        Delay 1000
        pay(i)= Sys.GetClipText()
        
        TracePrint pay(i)
        Delay 1000
        '① 必须包含 out_trade_no
        If InStr(1, pay(i), "out_trade_no") < 1 Then
            TracePrint "第" & i & "条无效：不包含 out_trade_no"
            Exit Function
        End If

        '② 提取订单号
        当前订单号 = 提取订单号(pay(i))

        '③ 判断订单号是否有效
        If 当前订单号 = "" Then
            TracePrint "第" & i & "条无效：订单号为空或提取失败"
            Exit Function
        End If

        If Len(当前订单号) < 10 Then
            TracePrint "第" & i & "条无效：订单号长度异常：" & 当前订单号
            Exit Function
        End If

        orderNo(i) = 当前订单号
        TracePrint "第" & i & "条订单号：" & orderNo(i)

        '④ 判断当前订单号是否和前面重复
        For j = 1 To i - 1
            If orderNo(i) = orderNo(j) Then
                TracePrint "第" & i & "条订单号与第" & j & "条重复：" & orderNo(i)
                Exit Function
            End If
        Next

        TracePrint "第" & i & "条订单号有效且不重复"
    next	
    Delay 1000
    //开始充值
    For i = 1 To x
        zm.OpenURL pay(i)
        TracePrint pay(i)
        Do    
            For 20
                找图(0,0,0,0,"付款并开通免密支付2")
                If find=True Then  
                    TracePrint "进入支付宝了"
                    Delay 1000
                    Exit Do
                End If
                Delay 200
                找图(0,0,0,0,"app-zfb-确认付款")
            			If find=True Then  
                			TracePrint "支付宝是待支付"
                			Delay 500
                			Exit Do
            			End If
            			Delay 200
                找图 0,0,0,0, "web生成订单失败"
                If find=True Then 
                    Delay 1000
                End If
                Delay 800
                找图(0,0,0,0,"via打开支付宝")
                If find=True Then  
                    TracePrint "via允许打开支付宝"
                    tap tx,ty
                    Delay 100
                End If
                Delay 200
                找图(0,0,0,0,"via允许打开支付宝")
                If find=True Then  
                    TracePrint "via允许打开支付宝"
                    tap 531,1016
                    Delay 2000
                End If
				Delay 200
				找图 0,0,0,0, "支付宝自动跳开通成功界面 "
                If find=True Then 
                    KeyPress "Back"
                End If
                Delay 800
            Next
            
            TracePrint "没找到付款并开通免密支付按钮"
        Loop
        续费跳支付宝 (wpcj1)
        支付密码()
    Next
	
		   
End Function
