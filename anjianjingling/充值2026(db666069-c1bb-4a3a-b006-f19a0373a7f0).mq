Function 豪华一个月(xp)  
    xpx=xp
    TracePrint "充值会员"&pxtype& ","&xp
    If wp1 <=1 Then 
        TracePrint "web端开通0.88的"
        web端充值("wp1")
        续费跳支付宝(wp1)
        支付密码
        TracePrint "web充值结束，退出豪华一个月函数"
        czp=zfbp
        Exit Function
    Else 
        TracePrint "web不是0.88"
        到价格界面()
        If 苹果续费 = "已关闭" Then 
            Goto 领券充值
        ElseIf 苹果续费 = "已开启" Then
            充值失败 = true
            email="[充值失败了亲，请先取消苹果续费]<br>复制回复消息给用户后转接给人工手动处理]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
            status id, "失败", 2, email
            Exit Function
        End If
        查超级价格    
        app价格 ("ap1")
        email="[正在充值]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
        email=CStr(email)
        status id, "正在充值", 2, email
        If ap1 <=1 Then 
            TracePrint "在app端充值0.88"
            Call app充值("ap1", true)
            续费跳支付宝 (ap1) 
            支付密码
            TracePrint "app充值结束，退出豪华一个月函数"
            czp=zfbp
            Exit Function
        
        ElseIf hhsj1 <= ap1 and hhsj1 <= wp1 and hhsj1 <= cj1 and hhsj1 <= xp and hhsj1<=9 Then
            app充值("hhsj", true)
            续费跳支付宝 (ap1) 
            支付密码
            TracePrint "app充值结束，退出豪华一个月函数"
            czp=zfbp
            Exit Function
        ElseIf wp1 < ap1 and wp1 <= 9 and wp1<=cj1 and wp1<=xp Then
            TracePrint "在web端充值"
            web端充值("wp1")
            续费跳支付宝(wp1)
            支付密码
            TracePrint "web充值结束，退出豪华一个月函数"
            czp=zfbp
            Exit Function
        ElseIf ap1 <= wp1 and ap1 <= 9 and ap1<=cj1 and ap1<=xp Then
            TracePrint "在app端充值"
            Call app充值("ap1", true)                
            续费跳支付宝(ap1)
            支付密码
            TracePrint "app充值结束，退出豪华一个月函数"
            czp=zfbp
            Exit Function
        
        ElseIf cj1 <= 9 and cj1<=xp Then
            充值超级会员("cj1") 
            续费跳支付宝 (cj1) 
            支付密码
            TracePrint "超级充值结束，退出豪华一个月函数"
            czp=zfbp
            Exit Function
        ElseIf xp > 9 Then
            TracePrint "两端都不满足小于xp的定价"
            KeyPress "back"
            Delay 500
            KeyPress "back"
            Delay 500
            Goto 领券充值
        Else 
            TracePrint "充值失败"
            充值失败 = true
            If wp1 <= 9 or ap1 <= 9 or cj1 <= 9 Then 
                email="[亲，充值失败了，您账号充不了"&xp&"元一个月的，可充9.8元一个月，需要的话这单申请一下退款，去拍9.8元那个]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"&",sjx:"&sjx& ",豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态

           
            ElseIf 会员状态 = "是会员" Then
           
                email="[亲，充值失败了，您账号充不了"&xp&"元一个月的，可充12.8元一个月，需要的话这单申请一下退款，去拍12.8元那个]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"&",sjx:"&sjx& ",豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
            End If
            status id, "失败", 2, email
            
            Exit Function
  
        End If 
    End If
    Rem 领券充值
    
    If 会员状态 = "未开通" and xp>=9 Then 
        九元券充值(2) 
        If jyq = "有券" Then 
            TracePrint "九元券充值"
            支付密码 
            czp = 9
            充值成功=true
            Exit Function
        Else 
            TracePrint "使用生日券"
        End If
