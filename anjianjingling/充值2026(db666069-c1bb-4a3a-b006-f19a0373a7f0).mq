    Dim ok
    ok = WaitPic(0,0,0,0,"web未登陆",2,250,"web未登陆")
    If ok = 1 Then Tap x,y

    必须点击图片 66,962,236,1087,"web同意",0,0,8,200,500,2,"重启夸克","夸克登录-同意"
    Tap 236,301
    Delay 300
    Tap 271,309
    Delay 300
    InputText "15220132122"
    Delay 300
    Tap 612,414

    ' 验证码由外部输入/自动流程完成，最长等待约90秒；失败绝不继续点击后续页面
    必须等待界面 0,0,0,0,"web智能设备",90,1000,1,"重启夸克","夸克登录-智能设备页"
    Tap x+45,y+25
End Function
Function 分享()
    Dim copyTry
    必须点击图片 382,981,495,1084,"其他平台",0,0,12,200,1000,2,"无","分享-其他平台"
    必须点击图片 0,0,0,0,"via-logo分享",0,0,12,200,1000,2,"无","分享-Via"
    必须等待界面 0,0,0,0,"via礼品卡页面2|via3天",12,200,2,"无","分享-礼品卡页面"

    Touch 150,98,1000
    For copyTry = 1 To 3
        If 等待并点击图片(0,0,0,0,"via复制",0,0,10,200,200,"分享-复制") = 1 Then Exit Function
        等待状态回传 "分享-复制", "未找到复制按钮，第" & copyTry & "次重新长按"
        Touch 150,98,1000
    Next
    等待致命失败 "分享-复制", "via复制"
End Function
