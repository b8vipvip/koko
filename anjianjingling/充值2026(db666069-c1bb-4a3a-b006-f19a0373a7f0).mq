        For 15
            找图 0,0,0,0,"支付宝确认付款2"
            If x > 0 Then 
                TracePrint "进入支付宝了"
                Delay 1000
                Exit Do
            End If
            Delay 200
        Next
        Delay 200
    Loop
    	
    Do
        For 10
            Call 找图(0,0,0,0, "支付宝米3")
            If x > 0 Then 
                TracePrint x&","&y
                Exit Do
            End If
            Delay 200
            找图 0,0,0,0, "15元支付宝米5"
            If x > 0 Then 
                x = x - 5
                y=y-2
                Exit Do
            End If
            Delay 100
        Next
        Delay 100
    Loop
    If code=157 Then 
        dim 普通上标=y-20
        dim 普通下标=y+61
    ElseIf code = 178 Then
        普通上标=y-20
        普通下标=y+61
    End If
    提取文本 "android.widget.TextView", "","", 普通上标, "",  普通下标,"num","yes"
    If 识别 <> False and text1<>"" Then 
        ocr8 = CDbl(text1)
        hhzkp=ocr8
    Else 
        If IsNumeric(Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)) = true Then 
            hhzkp = CDbl(Abs(Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)))	
            TracePrint "支付金额:" &hhzkp
        
        Else
            TracePrint smartocr(x + 45, y-20, 550, y+61)
            If IsNumeric(SmartOcr(x + 45, y-20, 550, y+61)) = true Then 
                hhzkp = CDbl(Abs(SmartOcr(x + 45, y-20, 550, y+61)))	
                TracePrint "支付金额:" &hhzkp
           
            Else 
                TracePrint "识别出错，自定义支付金额:" &hhzkp
            End If
        End If
    End If
    p = hhzkp     
    Dim s, pos, prefix
    s = CStr(p)
    ' 找到第一次出现 "100" 的位置
    pos = InStr(1, s, "100")
    pos=pos-1
    If pos > 0 Then
        ' 取 "100" 之前的所有字符
        prefix = Left(s, pos)
    Else
        ' 没找到 "100" 就按原值处理（看你需要也可以置 0）
        prefix = s
    End If
    TracePrint "提取结果prefix:" & prefix
    p = CDbl(prefix)
    hhzkp = p
    TracePrint hhzkp
    If hhzkp = 2700 Then 
        hhzkp = 27
    elseIf hhzkp = 2100 Then 
        hhzkp = 21
    elseIf hhzkp = 1600 Then 
        hhzkp = 16
    elseIf hhzkp = 6400 Then 
        hhzkp = 64
    End If
    //判断金额
    If hhzkx = 3 Then 
        If (hhzk3 = hhzkp) = true Then 
            TracePrint "金额正确"
        Else 
            email=code&"卡住了，折扣付款时金额不对"
            //            status id, "卡了", 2, email
            返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续支付；取消：结束脚本",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定，继续支付"
            If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
            Delay 500    
        End If
    ElseIf hhzkx = 12 Then
        If (hhzk12 = hhzkp) = true Then 
            TracePrint "金额正确"
        Else 
            email=code&"卡住了，折扣付款时金额不对"
            //            status id, "卡了", 2, email
            返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续支付；取消：结束脚本",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定，继续支付"
            If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
            Delay 500       
        End If
    End If
    	
    	
    	
    Do
    	
    	
        for 5
            找图 0,0,0,0,"支付宝确认付款2"
            If x > 0 Then 
                TracePrint "点确认付款"
                Tap x, y
                Delay 500
                Exit do
            End If
        Next
        Delay 200
    Loop	
    	
    	
    	
    	
    //    run (code)	
End Function

Function 查豪华抽奖
    zm.OpenURL url_xycj
    Delay 1000
    Do
	
        For 15
            找图 0, 0, 0, 0, "豪华抽奖页面2"
            If x > 0 Then 
                TracePrint "yes"
                Exit Do
            End If
            Delay 200
            找图 0, 0, 0, 0, "豪华抽奖重新支付"
            If x > 0 Then 
                tap x,y
                Exit Do
            End If
            Delay 200
        Next
        Delay 200
    Loop
    Delay 500
    rem 是否已抽奖
    For 5
        找图 0, 0, 0, 0, "豪华抽奖x折"
        If x > 0 Then 
            TracePrint "yes"
            Delay 200
            Tap 182, 744
            Exit For
        Else 
            Tap 176, 744
            Delay 500
            找图 0, 0, 0, 0, "无抽奖次数"
            If x > 0 Then 
                Delay 1000
                goto 识别折扣
            End If
            找图 0, 0, 0, 0, "抽奖次数已用完"
            If x > 0 Then 
                Delay 1000
                goto 识别折扣
            End If
            找图 0, 0, 0, 0, "抽奖次数已用完2"
            If x > 0 Then 
                Delay 1000
                goto 识别折扣
            End If
                     
            找图 0, 0, 0, 0, "已锁定折扣"
            If x > 0 Then 
                Delay 1000
                goto 识别折扣
            End If
           	 
           	
        End If
        Delay 200
    Next
    Do
        For 15
		
            找图 0, 0, 0, 0, "开心收下2"
            If x > 0 Then 
                TracePrint "yes"
                Delay 200
                tap x,y
                Exit do
            End If
            Delay 200
        Next
        goto 是否已抽奖
    Loop
    Rem 识别折扣
    Delay 800
    Tap 520, 750
    Delay 500
	
    do
        for 1
            For 15
	
                找图 0, 0, 0, 0, "幸运抽奖米2"
                If x > 0 Then 
                    TracePrint "yes"
                    x1 = x + 36
                    y1 = y - 21
                    Exit Do
                End If
                Delay 200
                找图 0, 0, 0, 0, "幸运抽奖米5"
                If x > 0 Then 
                    TracePrint "yes"
                    x1 = x + 36
                    y1 = y - 21
                    Exit Do
                End If
                Delay 200
                Tap 579, 610
                Delay 300
                Tap 520, 750
                Delay 500
            Next
            
        Next
        hhzk = False
        截图 "特殊界面"
        Exit Function
    Loop
    do
        找图 0, 0, 0, 0, "幸运抽奖立省"
        If x > 0 Then 
            TracePrint "yes"
            x2 = x - 7
            y2 = y + 61 
            Exit Do
        End If
        Delay 200
        找图 0, 0, 0, 0, "幸运抽奖立省2"
        If x > 0 Then 
            TracePrint "yes"
            x2 = x - 7
            y2 = y + 61 
            Exit Do
        End If
        Delay 200
        找图 0, 0, 0, 0, "幸运抽奖立省3"
        If x > 0 Then 
            TracePrint "yes"
            x2 = x - 7
            y2 = y + 61 
            Exit Do
        End If
        Delay 200
    Loop
    TracePrint x1&","&y1&","&x2&","&y2
    ocr8 = Image.OcrText(x1,y1,x2,y2, 0, 0)
    TracePrint ocr8
    TracePrint IsNumeric(ocr8)
    If IsNumeric(ocr8) = true and ocr8<>0 Then 
        ocr8 = ocr8 / 216 * 10
        ocr8 = CDbl(Abs(ocr8))
        hhzk3 = ABS(FIX(ocr8*0.1*54))
        hhzk12 = Abs(Fix(ocr8 * 0.1 * 216))
        Tap 368, 757
        Delay 200
    Else  
        TracePrint "识别不到折扣"
        email= "[识别抽奖折扣失败][" & pxtype&"]wp1:" & wp1 & ",ap1:" & ap1 & ",cj1:" & cj1 & ",hhsj1:" & hhsj1& ",sj30:" & sj30& ",豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息
        status id, "卡了", 2, email
        hhzk = False
        Exit Function
    End If

	
    TracePrint hhzk3
    TracePrint hhzk12
    run (code)
End Function
