Function 开通会员()
    '是否开通会员
    If 会员规格 = "no" Then 
        TracePrint "不开通会员"
        Exit Function
    End If
    TracePrint "去账号中心截图"
    tj = "首次"
    推荐页到个人信息
   
    
    Call 截图("充值前")'变量i是命名的后缀，0代表充值前，1代表充值后
    tj = "二次"
    
    cstatus (id)
    TracePrint c_status
    If c_status = 2 or c_status = "2" Then 
        TracePrint "充值被拦截"
        email="[充值过程被手动拦截了]<br>"&手机号&","&验证码&","&pxtype&","&多账户&","&code
        email=CStr(email)
        status id, "已拦截", 2, email
        ord_result(oid,"拦截") 
        Exit Function
    End If
    email="[开始充值]<br>"&手机号&","&验证码&","&pxtype&","&多账户&","&code
    status id, "登录成功", 2, email
    If 会员规格 = "hh1" Then 
        TracePrint "开通豪华一个月"        
        
        豪华一个月 (xps)
        
        
    ElseIf 会员规格 = "hh3" Then 
        TracePrint "开通豪华三个月"
        豪华三个月(xps)
            
    ElseIf 会员规格 = "hh12" Then 
        TracePrint "开通豪华一年"
        豪华一年(xps)
        
    ElseIf 会员规格 = "cj1" Then 
        TracePrint "开通超级一个月"
        超级一个月(xps)    
        
    ElseIf 会员规格 = "cj3" Then 
        TracePrint "开通超级三个月"
        超级三个月(xps) 
        
    ElseIf 会员规格 = "cj12" Then 
        TracePrint "开通超级一年"
        超级一年 (xps)
    ElseIf order_type="ct1" Then 
        TracePrint "开通TV一个月"
        超级一个月(xps)
    End If
    
    If 充值失败 = true Then 
        Exit Function
    
    End If
    运行时长
    TracePrint "重启软件从新打开账号中心并截图"
    email = "[充值成功]<br>[" & pxtype & "][czp:" & czp & "][lp:" & lp & "][wp1:" & wp1 & "][wpcj1:" & wpcj1 & "][ap1:" & ap1 & "][cj1:" & cj1 & "]" & "[hhsj1:" & hhsj1 & "][ap3:" & ap3 & "]" & "[wp3:" & wp3 & "]" & "[wp12:" & wp12 & "][" & "ap12:" & ap12 & "][sj30:" & sj30 & "]" & "[jyq:" & jyq & "]" & "[swyq:" & swyq & "]" & "[hhzk3:" & hhzk3 & "]" &"[sjx:"&sjx& "]豪华状态:" & 豪华状态 & ",超级状态" & 超级状态 & ",会员信息:" & 会员信息 & ",豪华天数:" & 豪华天数 & ",苹果续费:" & 苹果续费状态 & "时间：" & timelong
    email=CStr(email)
    status id, "充值成功", 2, email
    推荐页到个人信息
    If p3cj = 1 Then 
        TracePrint "p3cj跳过截图"
    Else
        If 会员状态 = "是会员" Then 
            截图 ("充值成功")        
        Else 
            推荐页到个人信息 
            截图 ("充值成功")
        End If  
    End If 
    lp=xpx-czp
    email="[充值成功]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"&"sjx:"&sjx&"]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态&"时间："&timelong
    email=CStr(email)
