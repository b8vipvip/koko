            End If
            找图 0,0,0,0, "九元无资格"
            If x > 0 Then 
                TracePrint "找到九元券支付宝"
                TracePrint x&","&y
                Delay 300
            
                jyq="无券"
                Exit Function         
            End If
            找图 0,0,0,0, "九元无资格2"
            If x > 0 Then 
                TracePrint "找到九元券支付宝"
                TracePrint x&","&y
                Delay 300
            
                jyq="无券"
                Exit Function         
            End If
        
            找图 0,0,0,0, "九元无资格3"
            If x > 0 Then 
                TracePrint "找到九元无资格"
            
                jyq="无券"
                Exit Function  
                  
            End If
            找图 0,0,0,0, "12元无资格"
            If x > 0 Then 
                TracePrint "找到12元无资格"
            
                jyq="无券"
                Exit Function  
                  
            End If
        
            Delay 200
            关闭广告 
        Next
        KillApp via
        Delay 500
        goto 重新打开
    Loop
    do
        for 25
            找图 0,0,0,0, "app9元券"
            If find=true Then 
                TracePrint "找到app9元券"
                Delay 300
                Tap tx+456,ty+51'点开通
                Delay 500
                Exit Do          
            End If
            Delay 200
        Next
        KillApp via
        Delay 500
        goto 重新打开
    Loop
    do
        for 20
            找图 0,0,0,0, "九元券支付宝"
            If x > 0 Then 
                TracePrint "找到九元券支付宝"
                TracePrint x&","&y
                Delay 300
          	
                Exit Do          
            End If
            找图 0,0,0,0, "九元无资格"
            If x > 0 Then 
                TracePrint "找到九元券支付宝"
                TracePrint x&","&y
                Delay 300
            	
                jyq="无券"
                Exit Function         
            End If
            找图 0,0,0,0, "九元无资格2"
            If x > 0 Then 
                TracePrint "找到九元券支付宝"
                TracePrint x&","&y
                Delay 300
            	
                jyq="无券"
                Exit Function         
            End If
            Delay 200
            找图 0,0,0,0, "app9元券"
            If find=true Then 
                TracePrint "找到app9元券"
                Delay 300
                Tap tx+456,ty+51'点开通
                Delay 500     
            End If
        Next
        KillApp kg
        Delay 500
        goto 重新打开
    Loop
    If pd9yq = 1 Then 
        jyq = "有券"
        
        Exit Function
    End If
    Tap x,y'点支付宝
    Delay 2000
    do
        找图 0,0,0,0, "9元支付宝米"
        If x > 0 Then 
            jyq="有券"
            Exit Do
        End If
        Delay 200
        找图 0,0,0,0, "支付宝米3"
        If x > 0 Then 
            jyq="有券"
            Exit Do
        End If
        Delay 200
        找图 0,0,0,0, "15元支付宝米5"
        If x > 0 Then 
            x = x - 5
            y = y - 2
            jyq="有券"
            Exit Do
        End If
        Delay 300
    loop
    If IsNumeric(Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)) = true Then 
        hhzkp = CDbl(Abs(Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)))	
        TracePrint "Text金额:" &hhzkp
        TracePrint "smart金额:"&smartocr(x + 45, y-20, 550, y+61)
    Else
        TracePrint smartocr(x + 45, y-20, 550, y+61)
        If IsNumeric(SmartOcr(x + 45, y-20, 550, y+61)) = true Then 
            hhzkp = CDbl(Abs(SmartOcr(x + 45, y-20, 550, y+61)))	
            TracePrint "Smart金额:" &hhzkp
            TracePrint "Text金额:"&Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)
       
        Else 
            TracePrint "识别出错，自定义支付金额:" &hhzkp
        End If
    End If
    p = hhzkp     
    Dim s, pos, prefix
    s = CStr(p)
    ' 找到第一次出现 "100" 的位置
    pos = InStr(1, s, "100")
    pos=pos-1
    If pos > 0 Then
        ' 取 "100" 之前的所有字符
        prefix = Left(s, pos)
    Else
        ' 没找到 "100" 就按原值处理（看你需要也可以置 0）
        prefix = s
    End If
    TracePrint "提取结果prefix:" & prefix
    p = CDbl(prefix)
    hhzkp = p
    TracePrint hhzkp
    If hhzkp = 9100 Then 
        hhzkp=9
    elseIf hhzkp = 8 Then 
        hhzkp=9
    End If
    If hhzkp <> 9 Then 
        TracePrint "金额不对，不等于9"
        email=code&"金额不对，不等于9<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态

        status id, "卡了", 2, email
        返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续支付；取消：结束脚本",1)
        TracePrint 返回条件
        If 返回条件 = 0 Then ShowMessage "确定，继续支付"
        If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
        Delay 500 
    End If
    do
        For 35
         
            找图 0,0,0,0,"支付宝确认付款2"
            If x > 0 Then 
                Tap x, y
                Delay 500
                Exit do
                    
            End If
            Delay 200
            
        Next
        Delay 200
    Loop
    appzf = True
    run (code)
    九元券充值=1
End Function
Function 判断十五券
    If 会员状态 = "是会员" Then 
        swyq="无券" 
        Exit Function 
    End If
 
    '打开券链接
    zm.OpenURL url_jyq
    Delay 1000
    Do
        For 50
            找图 0,0,0,0, "web秒杀券页面"
            If x > 0 Then 
                TracePrint "进入web秒杀券页面了"
                
                Exit Do          
            End If     
        Next
    
        Delay 200
    Loop 

    Do
        for 15
            找图 0,0,0,0, "web15元"
            If x > 0 Then 
                TracePrint "找到web15元"
                swyq="有券"
                Exit Do          
            End If 
        next  
        '找不到15元券,退出领15元券
        swyq="无券" 
        Exit Do 
        Delay 200
    Loop
    run (code)
End Function
