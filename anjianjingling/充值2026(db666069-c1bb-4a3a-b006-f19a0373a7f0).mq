        End If
    End If
    
    run (code)
End Function
Function 到价格界面()
    Dim stepTry,ok
    TracePrint "==== 到价格界面：状态机开始 ===="

    ' 1. 必须进入会员中心并确认礼物图标
    For stepTry = 1 To 3
        RunApp kg
        Delay 1200
        ok = 等待任一图片(0,0,0,0,"我的会员|礼物图标",8,250,"价格界面-会员入口")
        If ok = 1 Then
            If 等待命中图 = "我的会员" Then Tap x,y : Delay 1000
            If 等待命中图 = "礼物图标" Then Exit For
            If 等待任一图片(17,1161,116,1263,"礼物图标",20,200,"价格界面-礼物图标") = 1 Then Exit For
        End If
        tj = "二次"
        推荐页到个人信息
        等待状态回传 "价格界面-会员入口", "第" & stepTry & "次重新导航"
    Next
    If stepTry > 3 Then 等待致命失败 "价格界面-会员入口", "我的会员|礼物图标"

    ' 2. 自动续费管理是可选弹层；发现则处理
    Tap 233,314
    Delay 800
    If 等待任一图片(17,780,597,1047,"app续费管理|app续费管理2",5,150,"价格界面-续费检查") = 1 Then 关闭续费 1

    ' 3. 必须确认豪华会员页
    Tap 299,95
    Delay 700
    For stepTry = 1 To 3
        If 等待任一图片(0,0,0,0,"豪华会员界面|豪华界面",15,180,"价格界面-豪华页") = 1 Then Exit For
        会员活动广告
        关闭广告
        Tap 299,95
        Delay 500
        等待状态回传 "价格界面-豪华页", "第" & stepTry & "次重新点击豪华VIP"
    Next
    If stepTry > 3 Then 等待致命失败 "价格界面-豪华页", "豪华会员界面|豪华界面"

    ' 4. 豪华状态必须明确，不能再使用“没找到就跳过”
    If 豪华状态 <> "是会员" Then
        必须等待界面 55,205,487,497,"豪华是会员|豪华是会员2|豪华是会员3|豪华是会员5|豪华是会员6|豪华已过期|豪华未开通|豪华未开通2",25,180,2,"关闭广告","价格界面-豪华状态"
        Select Case 等待命中图
        Case "豪华是会员","豪华是会员2","豪华是会员3","豪华是会员5","豪华是会员6"
            豪华状态 = "是会员"
        Case Else
            豪华状态 = "未开通"
        End Select
        TracePrint "豪华状态=" & 豪华状态
    End If

    ' 5. 必须确认超级会员页
    Tap 140,92
    Delay 700
    For stepTry = 1 To 3
        If 等待任一图片(0,0,0,0,"超级50加|超级界面超级VIP",15,180,"价格界面-超级页") = 1 Then Exit For
        If 静默找图(0,0,0,0,"豪华界面超级VIP") = 1 Then Tap x+20,y+20 : Delay 500
        会员活动广告
        等待状态回传 "价格界面-超级页", "第" & stepTry & "次重新点击超级VIP"
        Tap 140,92
    Next
    If stepTry > 3 Then 等待致命失败 "价格界面-超级页", "超级50加|超级界面超级VIP"

    If 超级状态 <> "是会员" Then
        必须等待界面 39,181,511,357,"未开通超级vip|超会是会员|超会已过期",8,200,2,"关闭广告","价格界面-超级状态"
        Select Case 等待命中图
        Case "超会是会员"
            超级状态 = "是会员"
        Case "超会已过期"
            超级状态 = "已过期"
        Case Else
            超级状态 = "未开通"
        End Select
        TracePrint "超级状态=" & 超级状态
    End If

    ' 6. 点击开通后必须真正进入超级价格确认页
    Tap 572,422
    Delay 1000
    For stepTry = 1 To 30
        If 静默找图(305,1116,710,1235,"超级确认协议") = 1 Then
            TracePrint "已进入超级会员价格界面"
            run code
            Exit Function
        End If
        If 静默找图(107,507,287,617,"超级50加") = 1 Then Tap 572,422 : Delay 1000
        If 静默找图(0,0,0,0,"app进会员服务") = 1 Then Delay 1200
        If 静默找图(0,0,0,0,"app进会员价格加载中") = 1 Then Delay 1200
        If stepTry Mod 10 = 0 Then 会员活动广告
        Delay 300
    Next
    等待致命失败 "价格界面-超级价格确认", "超级确认协议"
End Function
