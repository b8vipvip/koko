        TracePrint "订单号无效"
        status id, "无效订单", 2, "订单号无效"
        RestartScript
    ElseIf order_status = "2" Then
        status id, "重复订单", 2, "订单号无效"
        TracePrint "重复订单"
        RestartScript
    ElseIf order_status = "1" Then
        If UBound(rets) < 3 Then
            TracePrint "订单数据字段不足：" & uget
            status id, "无效订单", 2, "订单数据字段不足"
            RestartScript
        End If
        If IsNumeric(rets[3]) = false Then
            TracePrint "订单价格字段异常：" & uget
            status id, "无效订单", 2, "订单价格字段异常"
            RestartScript
        End If
        order_type = rets[2]
        TracePrint order_type
        Delay 200
        xps = CDbl(rets[3])
        TracePrint xps
    Else
        TracePrint "未知订单状态：" & order_status
        status id, "无效订单", 2, "未知订单状态：" & order_status
        RestartScript
    End If
End Function

// 遍历输出结果
Function Scan(tbl)
    TracePrint "共有: " & UBound(tbl) & " 条记录"
    For i = 0 To UBOUND(tbl)
        For Each k , v In tbl(i)
            TracePrint k, v
            rets=v
        Next
    Next
End Function


Function ord_result(idtype,details)
    If details = "拦截" or details = "开始" or details = "码失效" Then 
        If idtype = "手动充值" Then 
            Exit Function
        End If
    End If
    
    statusx = 1
    If details = "充值成功" or details = "充值一半" or details = "拦截" or details = "开始" Then
        statusx = 2
    End If
    
    dim postData = "xp=" & xps & "&type=" & order_type & "&orderID=" & oidd & "&orderIDtype=" & oid & "&result="&details&"&status="&statusx&"&llp=" & lp & "&czp=" & czp & "&dev=" & code & "&phone=" & 手机号 & "&email=" & email & "&processed=1"
    uget = URL.Post("http://127.0.0.1:5000/update_order_data", postData, 60)
    TracePrint "接口返回：" & uget
    
    If uget = "" Then
        TracePrint "订单更新接口无返回"
        Exit Function
    End If
    
    rets = Split(uget, "=")
    If UBound(rets) < 2 Then
        TracePrint "订单更新返回格式异常：" & uget
        Exit Function
    End If
    
    If rets[2] = "1" Then
        TracePrint "数据更新成功"
    ElseIf rets[2] = "2" Then
        TracePrint "未找到该orderID"
    Else
        TracePrint "更新失败，错误码：" & rets[2]
    End If
End Function


Function uporderid_status(orderid,err)
    If orderid <> "手动订单" and err= "验证失效" Then 
        dim Post数据,返回值
        post数据 = "{""orderID"":""" & orderid & """}"
        返回值 = Url.Post("http://127.0.0.1:5000/uporderid_status", Post数据)
        TracePrint 返回值	
    End If
End Function

Function 滑块验证
    Dim try
    rem 重新识别
    for try=1 to 5
        ' 生成时间戳（去掉 - : 空格）
        g = Replace(Replace(Replace(GetNetworkTime(), "-", ""), ":", ""), " ", "")
        TracePrint g
		
        dim timepath = "/" & "sdcard" & "/" & "pictures" & "/" & "ocr_yz" & "/"
		
        ' 截全屏（仅用于留档）
        dim jietu_full = timepath & g & "_" & code & "_" & 手机号 & "_全屏.png"
        SnapShot jietu_full
        Delay 300
		
        ' 截图用于识别（这张才传给后端）
        jietu = timepath & g & "_" & code & "_" & 手机号 & ".png"
        SnapShot jietu, 29, 259, 691, 638
		
        ' 重试获取坐标：最多 5 次
        uget = ""
        For i = 1 To 5
            uget = URL.Get("http://127.0.0.1:5000/get_coords?img=" & jietu, 60)
            If uget <> "" Then Exit For
            Delay 500
        Next
		
        ' 仍失败：本轮结束，进入下一次识别，不能继续 Split 空字符串
        If uget = "" Then
            email = "【卡住了，三天券需验证,需手动】"
            status id, "滑块验证", 2, email
            TracePrint "坐标接口无返回，本轮重新识别"
            Tap 174, 740
            Delay 1000
            Goto 下一次识别
        End If
        
        ' 获取成功：先校验字段数量再解析坐标
        a = Split(uget, ",")
        If UBound(a) < 3 Then
            TracePrint "坐标接口返回格式异常：" & uget
            Tap 174, 740
            Delay 1000
            Goto 下一次识别
        End If
        dim x0 = a[1]
        x1 = 145
        x2 = a[3]
        y1 = 676
        y2 = 676

        If x0 = "0" Then 
            TracePrint "获取x2坐标失败"
            If try = 5 Then 发邮件 "坐标为0,重新"&code
            tap 174,740
            Delay 1000
            goto 下一次识别
        elseif x0 = "targetxerr" Then 
            TracePrint "获取x2坐标不合理,重新"&code
            If try = 5 Then 发邮件 "坐标不合理"&code
            tap 174,740
            Delay 1000
            goto 下一次识别
        elseIf x2 = "0" Then 
            TracePrint "获取x2坐标失败"
            If try = 5 Then 发邮件 "坐标为0,重新"&code
            tap 174,740
            Delay 1000
            goto 下一次识别
        End If
        Dim tablejson="["&x1&","&y1&","&x2&","&y2&"]"
        dim path = timepath&g&"_"&code& "." & "txt"
        If Dir.Exist(path) = 2 Then 
           	
        Else 
            dim 返回值 = zm.FileCreate(path)
       	
        End If
        zm.FileWrite path, tablejson
        TracePrint zm.VarInfo(zm.FileReadLines(path))
        TracePrint x1&","&y1&","&x2&","&y2
        For 5
            找图 0,0,0,0, "via三天滑动验证"
            If x > 0 Then 滑动 :TracePrint "移动结束" :Delay 2000 :Exit For
            Delay 200
            找图 0,0,0,0, "via滑块界面"
            If x > 0 Then 滑动 :TracePrint "移动结束" :Delay 2000 :Exit For
            Delay 200
            找图 0,0,0,0, "via滑块界面2"
            If x > 0 Then 滑动 :TracePrint "移动结束" :Delay 2000 :Exit For
            Delay 200
        next
    	
    	
        Dim verifyPageTry,verifyStillHere
        verifyStillHere = False
        For verifyPageTry = 1 To 15
            If 静默找图(0,0,0,0,"via3天") = 1 Then
                TracePrint "进入领券界面"
                Delay 500
                Exit Function
            End If
            If 等待任一图片(0,0,0,0,"via三天滑动验证|via滑块界面|via滑块界面2",1,0,"滑块-结果检查") = 1 Then
                verifyStillHere = True
                Exit For
            End If
            Delay 300
        Next
        If verifyStillHere = False Then
            TracePrint "滑块后未确认成功页或验证页，本轮重新识别"
            Goto 下一次识别
        End If
TracePrint try
        If try = 5 Then Tap 174, 740 : Delay 1000 : Goto 邮件通知
        tap 174,740 :Delay 1000
    rem 下一次识别
    next
    
    rem 邮件通知
    ' 5次都失败：如果还停留在验证页 -> 发邮件
    For 5
        找图 0,0,0,0, "via三天滑动验证"
        If x > 0 Then email = "需手动验证," & code :TracePrint "自动验证多次，需手动" :发邮件(email) :goto 重新识别
        Delay 200
        找图 0,0,0,0, "via滑块界面"
        If x > 0 Then email = "需手动验证," & code :TracePrint "自动验证多次，需手动" :发邮件(email) :goto 重新识别
        Delay 200
        找图 0,0,0,0, "via滑块界面2"
        If x > 0 Then email = "需手动验证," & code :TracePrint "自动验证多次，需手动" :发邮件(email) :goto 重新识别
        Delay 200 
    Next
    Goto 重新识别
End Function
' =========================
' 高仿真人滑块（更稳版）
' - 两段式：快速到 88% -> 慢速贴边到 100%
' - 相关抖动：不是每步独立随机，更像手抖
' - 末端停顿 + 微调 + 精准落点
' =========================
' ========= 随机偏移函数 =========
Function RandOffset(min, max)
    RandOffsetx = Int((max - min + 1) * Rnd()) + min  
End Function

Function 滑动()
    TracePrint "开始滑动（抗风控版）"

    Dim dx, dy
    dx = x2 - x1
    dy = y2 - y1

    ' ---------- 总步数（两段） ----------
    RandOffset 14, 28
    Dim steps1 : steps1 = RandOffsetx     ' 第一段快
    RandOffset 12, 24
    Dim steps2 : steps2 = RandOffsetx     ' 第二段慢
    Dim stepsTotal : stepsTotal = steps1 + steps2

    ' ---------- y 抖动幅度 ----------
    RandOffset 1, 4
    Dim jitterMax : jitterMax = RandOffsetx

    ' ---------- 相关抖动 ----------
    Dim noiseY : noiseY = 0

    ' ---------- TouchDown 停顿 ----------
    TouchDown x1, y1, 1
    RandOffset 50, 180
    Delay RandOffsetx

    ' ---------- 两段式目标 ----------
    RandOffset 85, 92
    Dim midRatio : midRatio = RandOffsetx / 100
    Dim xMid, yMid
    xMid = x1 + dx * midRatio
    yMid = y1 + dy * midRatio

    ' ---------- 第一段：快速到 midRatio ----------
    Dim i, t, xt, yt, moveDur, stepDelay
    For i = 1 To steps1
        t = i / steps1

        ' ease-in 加速（随机轻微变化）
        Dim e1 : e1 = t ^ (1.8 + Rnd() * 0.4)

        ' 相关抖动
        RandOffset -jitterMax, jitterMax
        noiseY = noiseY * (0.6 + Rnd()*0.4) + RandOffsetx * (0.2 + Rnd()*0.3)

        ' 轻微横向抖动（偶尔）
        Dim jitterX : jitterX = 0
        If Rnd() < 0.2 Then
            RandOffset -1, 1
            jitterX = RandOffsetx
        End If

        xt = x1 + (xMid - x1) * e1 + jitterX
        yt = y1 + (yMid - y1) * e1 + noiseY

        ' 非线性随机速度
        RandOffset 40, 100
        moveDur = RandOffsetx
        RandOffset 5, 18
        stepDelay = RandOffsetx

        TouchMove Int(xt), Int(yt), 1, moveDur
        Delay stepDelay
    Next

    ' ---------- 中途微停 ----------
    RandOffset 30, 90
    Delay RandOffsetx

    ' ---------- 第二段：慢速贴边到 100% ----------
    For i = 1 To steps2
        t = i / steps2

        ' ease-out 减速（轻微随机）
        Dim e2 : e2 = 1 - (1 - t) ^ (1.8 + Rnd()*0.4)

        ' 抖动随接近终点递减
        Dim jm : jm = jitterMax * (1 - t)
        RandOffset -jm, jm
        noiseY = noiseY * (0.6 + Rnd()*0.4) + RandOffsetx * (0.2 + Rnd()*0.3)

        ' 偶尔轻微横向抖动
        jitterX = 0
        If Rnd() < 0.15 Then
            RandOffset -1, 1
            jitterX = RandOffsetx
        End If

        xt = xMid + (x2 - xMid) * e2 + jitterX
        yt = yMid + (y2 - yMid) * e2 + noiseY

        ' 随机速度
        RandOffset 60, 160
        moveDur = RandOffsetx
        RandOffset 8, 25
        stepDelay = RandOffsetx

        TouchMove Int(xt), Int(yt), 1, moveDur
        Delay stepDelay
    Next

    ' ---------- 末端停顿 ----------
    RandOffset 80, 350
    Delay RandOffsetx

    ' ---------- 可选微过冲 ----------
    RandOffset 0, 100
    Dim doOvershoot : doOvershoot = 0
    If RandOffsetx < 40 Then doOvershoot = 1

    If doOvershoot = 1 Then
        Dim ox, oy
        RandOffset 1, 5
        ox = x2 + RandOffsetx
        RandOffset -2, 2
        oy = y2 + RandOffsetx

        RandOffset 60, 150
        TouchMove ox, oy, 1, RandOffsetx
        RandOffset 30, 90
        Delay RandOffsetx
    End If

    ' ---------- 精确落点 + 松手前停顿 ----------
    RandOffset 90, 250
    TouchMove x2, y2, 1, RandOffsetx
    RandOffset 100, 300
    Delay RandOffsetx

    TouchUp 1
End Function
Function code_upload_batch
    Dim raw, post数据, 返回值

    raw = ""

    ' 1只收集非空券码
    If Trim(code1) <> "" Then raw = raw & code1 & ","
    If Trim(code2) <> "" Then raw = raw & code2 & ","
    If Trim(code3) <> "" Then raw = raw & code3 & ","
    If Trim(code4) <> "" Then raw = raw & code4 & ","
    If Trim(code5) <> "" Then raw = raw & code5 & ","

    ' 2如果一条都没有，直接返回
    If raw = "" Then
        TracePrint "? 没有可上传的券码"
        Exit Function
    End If

    ' 3去掉最后一个多余的逗号
    raw = Left(raw, Len(raw) - 1)

    TracePrint "原始 raw=" & Left(raw, 200)

    ' 4编码（顺序很重要：先 %，再 &）
    raw = Replace(raw, "%", "%25")
    raw = Replace(raw, "&", "%26")

    ' 5构造 POST 数据
    post数据 = "codes=" & raw

    TracePrint "post数据=" & Left(post数据, 200)

    ' 6发送
    返回值 = Url.Post("http://127.0.0.1:5000/code_upload_batch", post数据, 60)

    TracePrint "返回值长度=" & Len(返回值)
    TracePrint "返回值=" & 返回值
End Function


'========================
' 统一等待 / 点击 / 恢复框架
' - 可选等待：返回 1/0，由调用方决定下一步
' - 必须等待：多次恢复仍失败时截图、回传状态并重启脚本，绝不跳过继续
' - 多图使用 | 分隔，例如："图A|图B|图C"
'========================
Dim 等待命中图,等待步骤,等待恢复轮次

' 静默找图：避免高频等待时刷大量“没找到”日志
Function 静默找图(x1, y1, x2, y2, picName)
    FindPic x1, y1, x2, y2, "Attachment:" & picName & ".png", "000000", 0, 0.9, x, y
    If x > 0 Then
        find = True
        tx = x
        ty = y
        静默找图 = 1
    Else
        find = False
        x = -1
        y = -1
        tx = -1
        ty = -1
        静默找图 = 0
    End If
End Function

' 等待任意一张图片出现；成功返回1并把图片名写入 等待命中图
Function 等待任一图片(x1, y1, x2, y2, picNames, maxLoop, intervalMs, stepName)
    Dim waitIndex,picIndex,picList,picName
    等待命中图 = ""
    picList = Split(picNames, "|")
    For waitIndex = 1 To maxLoop
        For picIndex = 0 To UBound(picList)
            picName = Trim(picList[picIndex])
            If picName <> "" Then
                If 静默找图(x1, y1, x2, y2, picName) = 1 Then
                    等待命中图 = picName
                    If stepName <> "" Then TracePrint "[" & stepName & "] 已命中：" & picName & "，坐标=" & x & "," & y
                    等待任一图片 = 1
                    Exit Function
                End If
            End If
        Next
        If intervalMs > 0 Then Delay intervalMs
    Next
    If stepName <> "" Then TracePrint "[" & stepName & "] 等待超时，候选图：" & picNames
    等待任一图片 = 0
End Function

' 兼容旧调用：等待单图
Function WaitPic(x1, y1, x2, y2, picName, maxLoop, intervalMs, logText)
    WaitPic = 等待任一图片(x1, y1, x2, y2, picName, maxLoop, intervalMs, logText)
End Function

' 尝试找图并点击一次；成功返回1
Function TryTapPic(x1, y1, x2, y2, picName, offsetX, offsetY, postDelay, logText)
    If 静默找图(x1, y1, x2, y2, picName) = 1 Then
        If logText <> "" Then TracePrint logText & " | x=" & x & " y=" & y
        Delay 100
        Tap x + offsetX, y + offsetY
        If postDelay > 0 Then Delay postDelay
        TryTapPic = 1
        Exit Function
    End If
    TryTapPic = 0
End Function

' 等待任意图片并点击；成功返回1，超时返回0
Function 等待并点击图片(x1, y1, x2, y2, picNames, offsetX, offsetY, maxLoop, intervalMs, postDelay, stepName)
    If 等待任一图片(x1, y1, x2, y2, picNames, maxLoop, intervalMs, stepName) = 1 Then
        Tap x + offsetX, y + offsetY
        If postDelay > 0 Then Delay postDelay
        等待并点击图片 = 1
    Else
        等待并点击图片 = 0
    End If
End Function

' 统一恢复动作。恢复只负责把页面拉回可识别状态，不会让流程向后跳过。
Function 执行等待恢复(recoverMode)
    TracePrint "执行等待恢复：" & recoverMode
    Select Case recoverMode
    Case "关闭广告"
        关闭广告
        Delay 500
    Case "重启酷狗"
        KillApp kg
        Delay 800
        RunApp kg
        Delay 1800
        关闭广告
    Case "重启夸克"
        KillApp qk
        Delay 500
        RunApp qk
        Delay 1200
    Case "重启Via"
        KillApp via
        Delay 500
        RunApp via
        Delay 1200
    Case "重启支付宝"
        KillApp zfb
        Delay 800
        RunApp zfb
        Delay 1500
    Case "重启改机"
        KillApp "com.phoneinfo.changerpro"
        Delay 500
        RunApp "com.phoneinfo.changerpro"
        Delay 1000
    Case "最近任务"
        RunApp "com.android.systemui", ".recents.RecentsActivity"
        Delay 600
    Case "返回"
        KeyPress "back"
        Delay 500
    Case "回桌面"
        KeyPress "Home"
        Delay 500
    Case Else
        Delay 500
    End Select
End Function

' 恢复前统一记录一次，不在每个轮询中刷状态
Function 等待状态回传(stepName, detail)
    Dim waitDetail
    waitDetail = "[等待恢复][" & stepName & "]" & detail & ",设备:" & code & ",订单号:" & oid
    TracePrint waitDetail
    If CStr(id) <> "" Then
        status id, "等待重试", 2, waitDetail
        cstatus id
        If c_status = 2 or c_status = "2" Then
            status id, "已拦截", 2, "等待过程中收到手动拦截：" & stepName
            ord_result oid, "拦截"
            RestartScript
        End If
    End If
End Function

' 致命等待失败：必须终止当前流程，禁止继续进入下一业务步骤
Function 等待致命失败(stepName, picNames)
    Dim waitDetail
    waitDetail = "[等待超时][" & stepName & "]多次恢复后仍未确认目标界面，候选图：" & picNames & ",设备:" & code & ",订单号:" & oid
    TracePrint waitDetail
    截图 "特殊界面"
    If CStr(id) <> "" Then status id, "等待超时", 2, waitDetail
    email = waitDetail
    发邮件 email
    RestartScript
End Function

' 必须确认目标界面。失败时执行指定恢复动作；全部失败后重启脚本，不会向后跳过。
Function 必须等待界面(x1, y1, x2, y2, picNames, maxLoop, intervalMs, recoverTimes, recoverMode, stepName)
    Dim recoverIndex
    For recoverIndex = 0 To recoverTimes
        If 等待任一图片(x1, y1, x2, y2, picNames, maxLoop, intervalMs, stepName) = 1 Then
            必须等待界面 = 1
            Exit Function
        End If
        If recoverIndex < recoverTimes Then
            等待状态回传 stepName, "第" & (recoverIndex + 1) & "次等待超时，准备执行：" & recoverMode
            执行等待恢复 recoverMode
        End If
    Next
    等待致命失败 stepName, picNames
    必须等待界面 = 0
End Function

' 必须找到并点击目标图片。失败策略与 必须等待界面 相同。
Function 必须点击图片(x1, y1, x2, y2, picNames, offsetX, offsetY, maxLoop, intervalMs, postDelay, recoverTimes, recoverMode, stepName)
    If 必须等待界面(x1, y1, x2, y2, picNames, maxLoop, intervalMs, recoverTimes, recoverMode, stepName) = 1 Then
        Tap x + offsetX, y + offsetY
        If postDelay > 0 Then Delay postDelay
        必须点击图片 = 1
    Else
        必须点击图片 = 0
    End If
End Function

' 从最近任务中选择酷狗并继续支付，统一替代六段相同的无限循环
Function 选择最近任务酷狗()
    Dim recentTry
    For recentTry = 1 To 4
        If 等待任一图片(0, 0, 0, 0, "弹起列表酷狗app|弹起列表酷狗app2", 20, 200, "最近任务-酷狗") = 1 Then
            Tap x + 20, y + 10
            Delay 500
            支付密码
            选择最近任务酷狗 = 1
            Exit Function
        End If
        等待状态回传 "最近任务-酷狗", "未找到酷狗任务卡，第" & recentTry & "次重新打开最近任务"
        执行等待恢复 "最近任务"
    Next
    等待致命失败 "最近任务-酷狗", "弹起列表酷狗app|弹起列表酷狗app2"
    选择最近任务酷狗 = 0
End Function

' 从某个页面返回到上一级（多次back）
Sub BackN(n, intervalMs)
    Dim i
    For i = 1 To n
        KeyPress "back"
        Delay intervalMs
    Next
End Sub
'========================
' 主流程：领取权益
'========================
Function 领取一次智能权益()
    必须等待界面 0,0,0,0,"智能权益确认领取",20,300,2,"返回","领取权益-确认领取"
    Tap 462,492 : Delay 260
    Tap 432,629 : Delay 260
    Tap 406,761 : Delay 260
    Tap 394,915 : Delay 260
    Tap 374,1053 : Delay 1000

    必须等待界面 0,0,0,0,"领取成功|领权益成功关闭",20,500,2,"无","领取权益-成功确认"
    Tap 154,1097
    Delay 300
    领取一次智能权益 = 1
End Function

Function 领取权益()
    Dim ok,retry,claimIndex
    TracePrint "==== 开始领取权益 ===="

    For retry = 1 To 5
        ok = TryTapPic(0,0,0,0,"app直接领权益",0,0,900,"发现app直接领权益")
        If ok = 1 Then Goto 智能设备vip流程
        ok = TryTapPic(0,0,0,0,"app直接领权益2",0,0,900,"发现app直接领权益2")
        If ok = 1 Then Goto 智能设备vip流程
        Delay 200
    Next

    For retry = 1 To 3
        zm.OpenURL url_webcj
        Delay 1500
        If 等待并点击图片(0,0,0,0,"via领权益确定",45,25,12,200,2500,"领取权益-Web入口") = 1 Then Exit For
        等待状态回传 "领取权益-Web入口", "第" & retry & "次重新打开页面"
    Next
    If retry > 3 Then 等待致命失败 "领取权益-Web入口", "via领权益确定"

    Rem 智能设备vip流程
    TracePrint "进入智能设备VIP领取流程"
    For retry = 1 To 3
        If 等待任一图片(0,0,0,0,"智能设备vip",10,500,"领取权益-智能设备VIP") = 1 Then Exit For
        If WaitPic(0,0,0,0,"app未登陆",2,250,"app未登陆") = 1 Then
            等待致命失败 "领取权益-未登录", "app未登陆"
        End If
        If WaitPic(0,0,0,0,"app优惠券界面",2,250,"app优惠券界面") = 1 Then
            Tap 659,1124
            Delay 1500
        End If
        等待状态回传 "领取权益-智能设备VIP", "第" & retry & "次重新打开入口"
        zm.OpenURL url_webcj
        Delay 1500
    Next
    If retry > 3 Then 等待致命失败 "领取权益-智能设备VIP", "智能设备vip"

    Tap tx+378,ty+42
    Delay 800
    领取一次智能权益

    If duoci > 1 Then
        For claimIndex = 2 To duoci
            必须等待界面 0,0,0,0,"智能设备vip",10,300,2,"返回","领取权益-下一张权益"
            Tap tx+378,ty+42
            Delay 800
            领取一次智能权益
        Next
    End If

    KeyPress "back"
    Delay 500
    run code
    TracePrint "==== 领取智能VIP完成：回到账户中心 ===="
    领取权益 = 1
End Function
