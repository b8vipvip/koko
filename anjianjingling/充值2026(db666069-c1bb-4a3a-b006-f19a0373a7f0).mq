Function 超级升级(月数)
    
    
    If 苹果续费状态 = "true" Then 
        ys=月数
        cjsj=1
        超级升级充值 (ys)
        Exit Function	
    End If
    
    Rem 重新打开
    KillApp zfb
    Delay 500
    KillApp via
    Delay 500
    zm.OpenURL url_vip
    Delay 2000
    Do
        For 3
            找图 0, 0, 0, 0, "via价格界面"                
            If x > 0 Then 
                TracePrint "进入web价格界面"
                Exit Do
            End If
            Delay 200
            找图 0, 0, 0, 0, "via价格界面2"                
            If x > 0 Then 
                TracePrint "进入web价格界面"
                Exit Do
            End If
            Delay 200
            找图 0, 0, 0, 0, "via价格界面3"                
            If x > 0 Then 
                TracePrint "进入web价格界面"
                Exit Do
            End If
            Delay 200
            找图 0, 0, 0, 0, "via价格界面5"                
            If x > 0 Then 
                TracePrint "进入web价格界面"
                Exit Do
            End If
        Next
        TracePrint "不在价格页面" 
        zm.OpenURL url_vip
        
        Delay 2500
    Loop
    Tap 531,343
    Delay 500
    Do
        For 2
            For 3
                找图 0, 0, 0, 0, "via超级界面"                
                If x > 0 Then 
                    TracePrint "进入web价格界面"
                    Exit Do
                End If
                Delay 200
                找图 0, 0, 0, 0, "via超级界面2"                
                If x > 0 Then 
                    TracePrint "进入web价格界面"
                    Exit Do
                End If
            Next
            TracePrint "不在web超级界面" 
            Tap 531,343
            Delay 500
        Next
        KillApp via
        Delay 500
        goto 重新打开
    Loop
    Do
        For 20
            找图 0, 0, 0, 0, "via超级界面升级"                
            If x > 0 Then 
                TracePrint "web升级2元"
                Exit Do
            End If
            Delay 200
            找图 0, 0, 0, 0, "via升级30天"                
            If x > 0 Then 
                TracePrint "web升级30天"
                goto 点开通
            End If
            Delay 200 
        Next
        TracePrint "没找到界面使用app升级"
        Delay 500
        ys=月数
        sjpx=2
        cjsj=1
        超级升级充值 (ys)
        Exit Function
    Loop
    Tap 116,663
    Delay 500
    Do
        For 3
            找图 0, 0, 0, 0, "via超级界面升级月数"                
            If x > 0 Then 
                TracePrint "via超级界面升级月数"
                Exit Do
            End If
            
        Next
        TracePrint "via超级界面升级月数"
        Delay 500
    Loop
    rem 重新识别
    For 15
        xname = Image.OcrText(275,906,456,987, 0, 0)
        TracePrint xname
        If IsNumeric(xname)=False Then 
            TracePrint "取1位数"
            xname = xdpub.lua_正则匹配(xname, "%d")
        End If
        TracePrint xname
        xname=CDbl(xname)
        If xname > 1 Then 
            TracePrint "yes"
        End If
        If xname > 月数 Then 
            TracePrint "减一个月"
            Tap 121,944
            Delay 500
        ElseIf xname < 月数 Then
            Tap 605,946
            Delay 500
            TracePrint "加一个月"
        ElseIf xname = 月数 Then
            TracePrint "月份正确，退出循环" 
            goto 点开通
        End If
        Delay 200
    Next
    xname = Image.OcrText(275,906,456,987, 0, 0)
    TracePrint xname
    If IsNumeric(xname)=False Then 
        TracePrint "取1位数"
        xname = xdpub.lua_正则匹配(xname, "%d")
    End If
    TracePrint xname
    xname=CDbl(xname)
    If xname = 月数 Then 
        TracePrint "点开通"
        goto 点开通
    Else 
        goto 重新识别
    End If
    
    
    rem 点开通
    Delay 500
    Tap 388,1086
    Delay 500
    
    Do
        For 15
            找图 0, 0, 0, 0, "via继续购买2"
            If x > 0 Then 
                tap x,y
            End If
            Delay 1000
            找图 0, 0, 0, 0, "via支付宝"
            If x > 0 Then 
                TracePrint "via支付宝"
                Tap x,y
                Delay 500
                //点同意
                Exit Do
            End If
			
            找图 0, 0, 0, 0, "via支付宝2"
            If x > 0 Then 
                TracePrint "via支付宝"
                Tap x,y
                Delay 500
                //点同意
                Exit Do
            End If
            Delay 500
        Next
        Tap 314, 1059
        Delay 500
    Loop
    Delay 1000
    Do    
        For 10
            找图(0,0,0,0,"via打开支付宝")
            If x>0 Then  
                TracePrint "via允许打开支付宝"
                tap x,y
                Delay 200
                Exit Do
            End If
            Delay 200
        Next
        goto 重新打开
    Loop
    
    Do    
        For 15
            找图(0,0,0,0,"via允许打开支付宝")
            If x>0 Then  
                TracePrint "via允许打开支付宝"
                Tap 531,1016
                Delay 1500
                Exit Do
            End If
            Delay 100
        Next
        
        tap 363,537 
        Delay 200
    Loop
    Do    
        For 20
            找图(0,0,0,0,"付款并开通免密支付2")
            If find=True Then  
                TracePrint "进入支付宝了"
                Delay 1000
                zfbxy=False
                Exit Do
            End If
            Delay 200
            找图(0,0,0,0,"app-zfb-确认付款")
            			If find=True Then  
                			TracePrint "支付宝是待支付"
                			Delay 500
                			zfbxy=False
                			Exit Do
            			End If
            			Delay 200
            找图 0,0,0,0, "web生成订单失败"
            If find=True Then 
                Delay 1000
            End If
            Delay 800
            找图(0,0,0,0,"via打开支付宝")
            If find=True Then  
                TracePrint "via允许打开支付宝"
                tap tx,ty
                Delay 100
            End If
            Delay 200
            找图(0,0,0,0,"via允许打开支付宝")
            If find=True Then  
                TracePrint "via允许打开支付宝"
                tap 531,1016
                Delay 2000
            End If
			Delay 200
			找图 0,0,0,0, "支付宝自动跳开通成功界面 "
            If find=True Then 
                KeyPress "Back"
            End If
            Delay 800
        Next
        goto 重新打开
        TracePrint "没找到付款并开通免密支付按钮"
    Loop
    run (code)
End Function
