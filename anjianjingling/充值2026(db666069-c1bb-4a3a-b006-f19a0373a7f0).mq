        TracePrint "订单接口无返回"
        status id, "无效订单", 2, "订单接口无返回"
        RestartScript
    End If
    
    rets = Split(uget, ",")
    If UBound(rets) < 1 Then
        TracePrint "订单接口返回格式异常：" & uget
        status id, "无效订单", 2, "订单接口返回格式异常"
        RestartScript
    End If
    
    order_status = rets[1]
    TracePrint order_status
    
