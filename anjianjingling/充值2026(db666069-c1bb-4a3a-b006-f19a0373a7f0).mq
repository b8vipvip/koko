End Function

Function 领3天券()
    rem 重新取券
    codex = URL.Get("http://127.0.0.1:5000/code_fetch",60)
    TracePrint codex
    If codex = "0" Then 
        三天券 = "失败"
        Exit Function
    End If
    
    Rem 点击礼品卡
    zm.OpenURL codex
    Delay 2000
    Do
        For 15
            Call 找图(0,0,0,0, "via3天")
            If x > 0 Then 
                TracePrint "进入via3天"
                Delay 500
                Exit do
            End If
            Delay 200
        Next
        Delay 200
    Loop
    For 2
        TracePrint "是否已被领取"
        Call 找图(0,0,0,0, "via已被领取")
        If x > 0 Then 
            TracePrint "移除失效的三天券"
            goto 重新取券
        End If
        Delay 100
        找图 0,0,0,0, "via三天已失效"
        If x > 0 Then 
            TracePrint "三天已失效"
            goto 重新取券
        End If
    Next
  

    TracePrint "确认支付宝是否待支付"
    do
        If appzf = true Then 
            TracePrint "在app支付，跳过确认支付宝订单"
            Exit Do
        ElseIf webcz = 1 Then 
    		TracePrint "webcz,跳过检查支付宝"
    		Exit Do
    	End If
        RunApp "com.android.systemui",".recents.RecentsActivity"
        Delay 500 
        do
            for 15
                找图(0,0,0,0,"弹起列表支付宝")
                If x>0 Then  
                    Tap x+50,y+20
                    TracePrint "弹起列表支付宝"
                    Exit Do
                End If
                Delay 200
            next
        loop
        for 5
            找图(0,0,0,0,"付款并开通免密支付2")
            If x>0 Then  
                TracePrint "支付宝是待支付"
                RunApp via
                Delay 500
                Exit Do
            End If
            Delay 200
            找图(0,0,0,0,"app-zfb-确认付款")
            If x>0 Then  
                TracePrint "支付宝是待支付"
                RunApp via
                Delay 500
                Exit Do
            End If
            Delay 200
        Next
        TracePrint "没有找到支付宝订单信息"
        email="进入支付宝没有找到订单信息"
        status id, "卡了", 2, email
    Loop
    
    Do
        For 15
            找图 0, 0, 0, 0, "via3天"
            If x > 0 Then 
                Tap 335,782'点击立即领取
                TracePrint "点击立即领取"
                Exit Do
            End If
            Delay 200
        Next
        goto 点击礼品卡 
    loop

    
    Do
        for 5
            找图 0,0,0,0, "via三天已经领取过"
            If x > 0 Then 
                TracePrint "无法领三天券"
                三天券="失败"
                code1=codex
                TracePrint "三天券回库"
                code_upload_batch
                Exit Function
            End If
            Delay 100
            找图 0,0,0,0, "via三天重复领取"
            If x > 0 Then 
                TracePrint "无法领三天券"
                三天券="失败"
                code1=codex
                TracePrint "三天券回库"
                code_upload_batch
                Exit Function
            End If
            Delay 100
            找图 0,0,0,0, "via三天重复领取"
            If x > 0 Then 
                TracePrint "无法领三天券"
                三天券="失败"
                code1=codex
                TracePrint "三天券回库"
