            If x > 0 Then 
                TracePrint "进入web价格界面"
                Exit Do
            End If 
        Next
        TracePrint "不在价格页面" 
        zm.OpenURL url_vip
        
        Delay 2500
    Loop
    
    If guige = "wp1" Then 
        TracePrint "充值一个月的"
        If wpcj = 1 and wpcj1 = wp1 Then 
            tap 668,96 '刷新一次
            Delay 1000
            Tap wp1x,wp1y
            TracePrint wp1x&","&wp1y
        End If
    ElseIf guige = "wp3" Then
        If wpcj = 1 Then 
            tap 668,96 '刷新一次
            Delay 1000
        End If
        TracePrint "充值三个月的"
        Tap wp3x,wp3y
        TracePrint wp3x&","&wp3y
        Delay 500
    ElseIf guige = "wp12" Then
        TracePrint "充值一年的"
        If wpcj = 1 Then 
            tap 668,96 '刷新一次
            Delay 1000
            Do
            	找图 0, 0, 0, 0, "via价格界面"                
            	If x > 0 Then 
                	TracePrint "via价格界面"
                	Exit Do
            	End If
            	Delay 200 
            	找图 0, 0, 0, 0, "via价格界面2"                
            	If x > 0 Then 
                	TracePrint "进入web价格界面"
                	Exit Do
            	End If
            	Delay 200 
            	找图 0, 0, 0, 0, "via价格界面3"                
            	If x > 0 Then 
                	TracePrint "进入web价格界面"
                	Exit Do
            	End If
            	Delay 200 
            	找图 0, 0, 0, 0, "via价格界面5"                
            	If x > 0 Then 
                	TracePrint "进入web价格界面"
                	Exit Do
            	End If 
            Loop
            TracePrint "往左滑动1格"
            TouchDown 511,495, 1
            Delay 100
            TouchMove 314,495, 1, 300
            Delay 50
            TouchUp 1
            Delay 500
            For 5
                找图(445,343,689,693, "via米年-豪华超级")
                If x > 0 Then 
                    Exit for
                End If
                Delay 200
                找图(445,343,689,693, "via米年1")
                If x > 0 Then 
                    Exit for
                End If
                Delay 200
                找图(445,343,689,693, "via米年-168")
                If x > 0 Then 
                    Exit for
                End If
                Delay 200
            Next
            Tap wp12x, wp12y
        else
            Tap wp12x, wp12y
            TracePrint wp12x&","&wp12y
            Delay 500
        End If
    End If
    Delay 300
   
    Tap 46, 964
    Delay 300
    do
        For 5
            
            找图(0,0,0,0, "web同意续费1")
            If x > 0 Then 
                TracePrint "找到随机取消字"
                x3 =x
                y3 = y
                Tap x, y
                Delay 300
                找色(x-40,y,x,y+40,"98C9E5")
                If x > 0 Then
                    TracePrint "续费选项已打钩" 
                    
                    TracePrint "点开通"
                    Tap 362,792
                    Delay 500
                    Exit do
                Else 
                    找色(x-40,y,x,y+40,"89C5EE")
                    If x > 0 Then
                        TracePrint "续费选项已打钩" 
                    
                        TracePrint "点开通"
                        Tap 362,792
                        Delay 500
                        Exit Do
                    End If
