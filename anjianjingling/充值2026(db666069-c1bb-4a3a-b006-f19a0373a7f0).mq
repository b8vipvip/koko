Function 领生日券(q)
    If q = "二次进入" Then 
        TracePrint "跳过改生日,直接领取"
        goto 二次进入
    End If
    rem 重新启动
    RunApp "com.kugou.android"
    Delay 2000
    关闭广告
    RunApp "com.kugou.android", ".useraccount.ModifyUserInfoActivity"
    Delay 1000
    Do
        Call 元素("基础信息", 0)
        If 临时 Then 
            TracePrint "进入编辑资料界面"
            tap 67,865'点击生日一栏
            Delay 1000
            Exit Do
        End If
        Delay 200
        关闭广告
    Loop
    Do
        For 10
            找图 230, 478, 486, 596, "改生日界面"
            If x > 0 Then 
                TracePrint "在改生日界面"
                Exit Do
            End If
            Delay 200
            元素 "生日",1
        Next
        Goto 重新启动
    loop
    do
        For 5
            临时=xdpub.元素查找({"resource-id":"com.kugou.android:id/a0v","text":"生日"})
            If 临时 Then 
                Exit do
            End If
        Next
        TracePrint "没找到元素，重新打开"
        KillApp kg
        Goto 重新启动
    loop
    layout = Element.GetAllInJson()
    layoutTable = Encode.JsonToTable(layout)
    //传入一个主要内容层的数据
    allText = Element.GetText(layoutTable[Len(layoutTable)])
    /*
    For Each i In allText'<打印文本内容，用于判断位于第几个元素>
        TracePrint i
    Next
     */
    TracePrint UBOUND(allText) + 1
    a = allText(0)
    TracePrint a
    b = "今年您已经修改过生日，一年只能修改一次哦~"
    //nowm为当天月份
    nowm = CInt(xdpub.lua_正则匹配(Date(), "%d%d%d%d/(%d%d)/%d%d"))
    TracePrint "现在月份："&nowm
    //nowd为当天日数
    nowd = CInt(xdpub.lua_正则匹配(Date(), "%d%d%d%d/%d%d/(%d%d)"))
    TracePrint "现在日数："&nowd
    //获取当前月份
    xm = CDbl(SmartOcr(339, 834, 383, 880))
    //获取当前日数
    xday = CDbl(SmartOcr(544, 834, 605, 883))
    If a = b and nowm<>xm and nowd<>xday Then 
        TracePrint "不能改生日"
        生日券 = False
    ElseIf a <> b Then
        TracePrint "可以改生日"
        生日券 = True
    ElseIf nowm=xm and nowd=xday then
        TracePrint "可以改生日"
        生日券 = True
    End If
    If 生日券=True Then 
        TracePrint "可以改生日"
        //a为当天月份
        a = CInt(xdpub.lua_正则匹配(Date(), "%d%d%d%d/(%d%d)/%d%d"))
        TracePrint a
        //b为当天日数
        b = CInt(xdpub.lua_正则匹配(Date(), "%d%d%d%d/%d%d/(%d%d)"))
        TracePrint b
        //获取当前月份
        For 5
            c = CDbl(SmartOcr(339, 834, 383, 880))
            If IsNumeric(c) = True Then 
                TracePrint "找到月份"
                TracePrint c
                // 滚动到目标月份
                For 10
                    e = (a < c)
                    f = (a > c)
                    If a = c Then 
                        TracePrint "已改好月份"
                        Exit for
                    Else 
                        If e=True Then
                            For i = 1 To c-a
                                TouchDown 363, 768, 1
                                Delay 100
                                TouchMove 357,858,1,200 // 模拟向上滑动
                                Delay 50  // 滑动后等待一下
                                TouchUp 1
                                Delay 100
                            Next
                        ElseIf f=true Then
                            For i = 1 To a - c
                                TouchDown 357, 858, 1
                                Delay 100
                                TouchMove 363, 768 ,1,200 // 模拟向上滑动
                                Delay 50  // 滑动后等待一下
                                TouchUp 1
                                Delay 100
                            Next
                        End If
                    End If
                    c = CDbl(SmartOcr(339, 834, 383, 880))
                Next
                Exit For
            Else 
                TracePrint "没找到月份"
                生日券 = False
                Exit Function
            End If
        Next
        //获取当前日数
        For 5
            d=CDbl(SmartOcr(544,834,605,883))
            If IsNumeric(d) = True And d<32 Then 
                TracePrint "找到日数"
                TracePrint d
                // 滚动到目标号数
                For 10
                    If b = d Then 
                        TracePrint "已改好日数"
                        TracePrint "点确定"
                        Delay 500
                        Tap 361, 1149
                        Delay 1000
                        Exit For
                    Else 
                        If (b < d) = True Then 
                            For i = 1 To d - b
                                TouchDown 575, 768, 1
                                Delay 100
                                TouchMove 575,858,1,150 // 模拟向上滑动
                                Delay 100  // 滑动后等待一下
                                TouchUp 1
                                Delay 100
                            Next
                        ElseIf (b > d)=true Then
                            For i = 1 To b - d
                                TouchDown 575, 858, 1
                                Delay 100
                                TouchMove 575, 768 ,1,150 // 模拟向上滑动
                                Delay 100  // 滑动后等待一下
                                TouchUp 1
                                Delay 100
                            Next
                        End If
                    End If
                    d=CDbl(SmartOcr(544,834,605,883))
                Next
                Exit For
            Else 
                TracePrint "没找到日数"
                生日券 = False
                Exit Function
            End If
        Next
    Else 
        TracePrint "无法改生日"
        生日券 = False
        KeyPress "back"
        Delay 500
        KeyPress "back"
        Delay 500
        Exit Function
    End If 
    //领取生日券
    Rem 二次进入
    TracePrint "去领取生日券"
    RunApp via
    Delay 1500
    //    先判断当前夸克界面是否在自己生日券界面
    For 2
        Call 找图(544, 424, 680, 495, "开通")
        If x > 0 Then 
            TracePrint "是夸克领券页面"
            Call 找图(602, 1179, 691, 1253, "夸克菜单")
            If x > 0 Then 
                TracePrint "找到夸克菜单"
                Tap x, y
                Delay 500
                For 20
                    Call 找图(557,949,661,1069, "夸克刷新")
                    If x > 0 Then 
                        TracePrint "找到夸克刷新"
                        Tap x, y
                        Delay 1000
                        Goto 重新找弹窗
                    Else 
                        TracePrint "没找到夸克刷新"
                    End If
                    Delay 100
                Next
            Else 
                TracePrint "没找到夸克菜单"
            End If
        Else 
            TracePrint "不是夸克领券页面"
        End If
        Delay 100
    Next
    Rem 重新打开夸克
    //选择优惠券
    zm.OpenURL url_srq
    Delay 2500
    Rem 重新找弹窗
    do
       
        For 15
            Call 找图(231,607,501,692,"去酷狗使用")
            If x>0 Then
                TracePrint "找到弹窗"
                Delay 500
                Tap x,y
                Goto 跳过去酷狗使用
            Else 
                TracePrint "没找到弹窗"
            End If
            Delay 200
        Next
            
        goto 重新打开夸克
    loop
    Rem 跳过去酷狗使用
    Delay 2000
    Do
        For 5
            找图(16,56,433,147,"app生日券界面")
            If x>0 Then 
                TracePrint "找到app生日券界面"
                Delay 500
                Exit do
            End If
            Delay 200
        Next
        找图(0,0,0,0,"网络异常")
        If x>0 Then 
            TracePrint "找到网络异常"
            Tap 361,663
            Delay 1000
        End If
        TracePrint "没找到app生日券界面"
        关闭广告
    loop
    Delay 1500
    Do
        For 3
            找色(260,183,551,237,"3F3FFD")
            If x>0 Then 
                TracePrint "找到红色开通按钮"
                Delay 500
                Exit do
            End If
            Delay 200
        Next
        For 3
            找图(260,183,551,237,"我知道了")
            If x>0 Then 
                TracePrint "领券失败"
                生日券 = False
                Exit Function
            End If
            Delay 200
        Next
        TracePrint "没找到红色开通按钮"
        Exit Do
    Loop
    //再找一次开通按钮
    Do
        For 15
   		

            FindColor 547,682,683,747,"3F3FFD",0,1,intX,intY
            If intX > 0 And intY > 0 Then
                TracePrint "开通按钮为红色"
                生日券 = true
                Exit Do
            Else 
                FindColor 547, 682, 683, 747, "7E7E7E|323232", 0, 1, x, y
                If x > 0 Then 
                    生日券 = False
                    TracePrint "开通按钮灰色，生日券无效"
                    Exit Function
                End If
            End If
            Delay 100
        Next
        Delay 200
    Loop
    Do
        For 15
            找图 2,141,711,625, "生日券9元2"
            If x > 0 Then 
                TracePrint "生日券9元"
                生日券=true
                生日券年卡 = true
                Exit Do
            End If
            找图 2,141,711,625, "生日券9元"
            If x > 0 Then 
                TracePrint "生日券9元"
                生日券=true
                生日券年卡 = true
                Exit Do
            End If
            临时 = xdpub.元素查找({"text":"首月9元"})
            If 临时 Then 
                TracePrint "首月9元"
                生日券=true
                生日券年卡 = true
                Exit Do
            End If
            Delay 100
            找图 7,505,700,837, "赠送券27元2"
            If x > 0 Then 
                TracePrint "赠送券27元2"
                生日券=true
                生日券年卡 = true
                Exit Do
            End If
            临时 = xdpub.元素查找({"text":"首季27元"})
            If 临时 Then 
                TracePrint "首季27元"
                生日券=true
                生日券年卡 = true
                Exit Do
            End If
            Delay 100
            找图 2,141,711,625, "生日券108元2"
            If x > 0 Then 
                TracePrint "生日券108元"
                生日券 = False
                生日券年卡 = true
                苹果续费=true
                Exit Do
            End If
            Delay 200
        Next
       
    Loop
    run (code) 
End Function
Function 分享生日券() 
    rem 重新找赠送
    Delay 1000
    For 1
        Call 找图(0,0,0,0, "赠送")
        If x>0 Then 
            TracePrint "赠送按钮"
            Tap x+10,y+10
        Else 
            TracePrint "没找到赠送页面"
        End If
        Delay 1500
        For 10
            Call 找图(382, 981, 495, 1084, "其他平台")
            If x>0 Then 
                TracePrint "循环找其他平台"
                Exit For
            Else 
                TracePrint "循环没找其他平台"
            End If
        Next
        If x>0 Then 
            TracePrint "其他平台"
            Delay 100
            Call 分享()
            TracePrint "返回2次"
            KeyPress "back"
            Delay 200
            KeyPress "back"
            Delay 200
            Exit Function
        Else 
            TracePrint "没找其他平台"
            Goto 去领券
        End If
    Next
    Delay 200
    Rem 去领券
    //领取生日券
    Rem 重新打开夸克
    //选择优惠券
    zm.OpenURL url_srq
 
    Delay 1000
    Rem 重新找弹窗
    do
        For 2
            For 5
                Call 找图(231,607,501,692,"去酷狗使用")
                If x>0 Then
                    TracePrint "找到弹窗"
                    Delay 500
                    Tap x,y
                    Goto 跳过去酷狗使用
                Else 
                    TracePrint "没找到弹窗"
                End If
                Delay 100
            Next
            Call 找图(602, 1179, 691, 1253, "夸克菜单")
            If x > 0 Then 
                Tap x, y
                Delay 500
            End If
            For 5
                Call 找图(557,949,661,1069, "夸克刷新")
                If x > 0 Then 
                    Tap x, y
                    Delay 1000
                    Exit for
                End If
                Delay 100
            Next
            Delay 100
        Next
    loop
    Rem 跳过去酷狗使用
    Delay 2000
    Do
        For 5
            找图(16,56,433,147,"app生日券界面")
            If x>0 Then 
                TracePrint "找到app生日券界面"
                Delay 500
                Exit do
            End If
            Delay 200
        Next
        TracePrint "没找到app生日券界面"
        Delay 200
    loop
    Delay 1000
    Do
        For 15
            找色(260,183,682,776,"3F3FFD")
            If x>0 Then 
                TracePrint "找到红色开通按钮"
                Delay 500
                Exit do
            End If
            Delay 200
        Next
        TracePrint "没找到红色开通按钮"
        Delay 200
    loop
    Goto 重新找赠送
    
End Function

Function 领券付款()
    Delay 2000
    rem re
    If cou = "coupon2" Then 
        do	
            找图 0, 0, 0, 0, "生日券9元"
            If x > 0 Then 
                TracePrint x -148, y + 118
                Tap x -148, y + 118'点同意
                Delay 500
                Tap x +402, y + 33'点开通
                Exit Do
            End If
            Delay 100
            TracePrint "没找到价格图标，没有点开通"
            找图 0, 0, 0, 0, "生日券被使用"
            If x > 0 Then 
                If 生日券 = true Then 
                    生日券 = False
                    Exit Function
                End If
                If 赠送券 = true Then 
                    赠送券 = False
                    Exit Function
                End If
            End If
            找图(0,0,0,0,"网络异常")
            If x>0 Then 
                TracePrint "找到网络异常"
                Tap 361,663
                Delay 1000
            End If
        Loop
        srq = 9
        
    ElseIf cou = "coupon3" Then
        Do
            找图 0, 0, 0, 0, "生日券27元"
            If x > 0 Then 
                TracePrint x -148, y + 118
                Tap x -143, y + 118'点同意
                Delay 500
                Tap x +399, y + 33'点开通
                Exit Do
            End If
            Delay 100
            TracePrint "没找到价格图标，没有点开通"
        Loop
        srq = 27
    ElseIf cou = "coupon4" Then 
        Do
            找图 0, 0, 0, 0, "生日券108元"
            If x > 0 Then 
                TracePrint x -148, y + 118
                //Tap x -148, y + 118'点同意
                Delay 500
                Tap x +398, y + 33'点开通
                Exit Do
            End If
            Delay 100
            TracePrint "没找到价格图标，没有点开通"
        Loop
        srq = 108
    End If  
    
    do
        For 35
            找图 0,874,221,960, "应付金额"
            If x>0 Then 
                TracePrint "弹起支付选项"
                
                Exit Do
            Else 
                TracePrint "没有弹起支付选项"
            End If
            Delay 200
        Next
        email="[生日券没有弹起]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
        status id, "卡了", 2, email
        Goto re
    Loop
    Delay 1000
    For 5
        TracePrint Image.OcrText(170, 892, 345, 953, 0, 0)
        
        p=Image.OcrText(170, 892, 345, 953, 0, 0)
        p = Replace(Replace(Replace(p,"'", "."),"元",""),"′",".")
        TracePrint p
        
        If IsNumeric(p) = true Then 
            TracePrint "识别到金额了"
            p=CDbl(abs(p))
            Exit For
        Else 
            TracePrint "金额不对"
        End If
        Delay 100
    Next  
    If p = "90" Then 
        p = "7.5"
        TracePrint p
    ElseIf p = "270" Then
        p = "27"
        TracePrint p
    End If
    TracePrint "最终识别价格"
    If cou = "coupon2" Then 
        If p = "9" or p=9 Then 
            TracePrint"金额正确"
        Else 
            TracePrint"金额不正确"
            email=code&"[卡住了，9金额不对]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态

            status id, "卡了", 2, email
            返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续支付；取消：结束脚本",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定，继续支付"
            If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
        End If
    elseIf cou = "coupon3" Then 
        If p = "27" or p = 27 Then 
            TracePrint"金额正确"
        Else 
            TracePrint"金额不正确"
            email= code&"卡住了，27金额不对"
            status id, "卡了", 2, email
            返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续支付；取消：结束脚本",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定，继续支付"
            If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
        End If 
    elseIf cou = "coupon4" Then 
        If p = "108" or p = 108 Then 
            TracePrint"金额正确"
            zfbxy = False
        Else 
            TracePrint"金额不正确"
            email= code&"卡住了，108金额不对"
            status id, "卡了", 2, email
            返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续支付；取消：结束脚本",1)
            TracePrint 返回条件
            If 返回条件 = 0 Then ShowMessage "确定，继续支付"
            If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
        End If
    End If
    Rem 重新点支付宝
    do 
        找图(1,887,594,1203,"券支付宝")
        If x>0 Then 
            TracePrint "支付宝支付"
            Delay 500
            tap x,y
            Exit do
        End If
        Delay 200
    loop
    Delay 2000
    Do
        for 20
            找图(0,0,0,0,"付款并开通免密支付2")
            If x>0 Then 
                TracePrint "付款"
                Delay 1000
                Exit do
            End If
            找图(0,0,0,0,"app-zfb-确认付款")
            	If x>0 Then  
                	TracePrint "支付宝是待支付"
                	Delay 1000
                	Exit Do
            	End If
            	Delay 200
            找图 0, 0, 0, 0, "苹果续费"
            If x > 0 Then 
                TracePrint x&","&y
                苹果续费 = true
                email="[需要关闭苹果续费后充值]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
                status id, "失败", 2, email
                RestartScript
            End If 
            Delay 200
            TracePrint "没找到付款并开通免密支付按钮"
            For 2
                找图(127,439,573,586,"密码界面")
                If x>0 Then 
                    TracePrint "在密码界面"
                    Exit Do
                End If
                Delay 200
                TracePrint "没有找到密码界面" 
            Next
            找图(1,887,594,1203,"券支付宝")
            If x>0 Then 
                TracePrint "支付宝支付"
            
                tap x,y
                Delay 2000
            End If
            找图(0,0,0,0,"券确认付款")
            If x>0 Then 
                TracePrint "支付宝支付"
            
                tap x,y
                Delay 2000
            End If
            Delay 50
        Next
        RunApp kg
        Delay 500
        goto 重新点支付宝
    Loop
    run (code)
End Function
Function 九元券充值(pd9yq)
    rem 重新打开
    '打开券链接
    zm.OpenURL url_jyq
    Delay 2000
     
    Do
        For 30
            找图 0,0,0,0, "via秒杀券页面"
