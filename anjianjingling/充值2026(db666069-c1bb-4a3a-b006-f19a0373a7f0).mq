        If wp1 <= 6 Then 
            x = x + 1 
        End If	
        email = "[三天券领取失败，等手动充值]<br>"&pxtype & "[wp1:" & wp1 & ",ap1:" & ap1 & ",cj1:" & cj1& ",wp3:" & wp3& ",ap3:" & ap3& ",hhzk3:" & hhzk3& ",sj30:" & sj30& ",hhsj1:" & hhsj1 & "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息
        发邮件"三天领取失败"
        返回条件 = Dialog.MsgBox("三天券领取失败",0)
        TracePrint 返回条件
        If 返回条件 = 0 Then ShowMessage "三天失败":EndScript
        Exit Function
    End If	
    Delay 1000
    //开始充值
    For i = 1 To x
        zm.OpenURL pay(i)
        TracePrint pay(i)
        Do    
            For 20
                找图(0,0,0,0,"付款并开通免密支付2")
