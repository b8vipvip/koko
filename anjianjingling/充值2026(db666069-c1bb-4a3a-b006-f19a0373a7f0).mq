                TracePrint "选择支付宝"
                Tap x,y
                Delay 300
                
            End If
            找图 0,0,0,0, "web开通"
            If x > 0 Then 
               
                Tap x,y
                Delay 1000
            End If
            找色 8, 727, 119, 851, "D89235|D9953A"
            If x > 0 Then 
                TracePrint "续费选项弹出"
                Tap 94, 771
                Delay 300
            End If
            Delay 100
        Next
        Delay 100
    loop
    Delay 1000
    
    Do    
        For 10
            找图(0,0,0,0,"via打开支付宝")
            If x>0 Then  
                TracePrint "via允许打开支付宝"
                tap x,y
                Delay 200
                Exit Do
            End If
            Delay 200
        Next
        goto 重新打开
    Loop
    
    Do    
        For 15
            找图(0,0,0,0,"via允许打开支付宝")
            If x>0 Then  
                TracePrint "via允许打开支付宝"
                Tap 531,1016
                Delay 1000
                Exit Do
            End If
            Delay 100
        Next
        
        tap 363,537 
        Delay 200
    Loop
    Do    
    	For 20
            找图 0,0,0,0, "app-zfb-确认付款"
            If find=True Then 
                Exit Do
            End If
            Delay 800
            找图(0,0,0,0,"付款并开通免密支付2")
            If find=True Then  
                TracePrint "进入支付宝了"
                Delay 1000
                Exit Do
            End If
            Delay 200
            找图 0,0,0,0, "web生成订单失败"
            If find=True Then 
                Delay 1000
            End If
            Delay 800
            找图(0,0,0,0,"via打开支付宝")
            If find=True Then  
                TracePrint "via允许打开支付宝"
                tap tx,ty
                Delay 100
            End If
            Delay 200
            找图(0,0,0,0,"via允许打开支付宝")
            If find=True Then  
                TracePrint "via允许打开支付宝"
                tap 531,1016
                Delay 2000
            End If
			Delay 200
			找图 0,0,0,0, "支付宝自动跳开通成功界面 "
            If find=True Then 
                KeyPress "Back"
            End If
            Delay 800
            
        Next
        goto 重新打开
        TracePrint "没找到付款并开通免密支付按钮"
    Loop
    run (code)
    支付对象="web"
End Function 
