Function app充值(guige, mfsj)'mfsj=true则升级超级会员
    Dim guigepic2,guigepic3,guigepic5,guigepic6
    rem 重新打开
    If guige = "ap1" Then 
        guigepic = "app连月"
        guigepic2 = "app连月2"
        guigepic3 = "app连月3"
        guigepic5 = "app连月5"
        guigepic6 = "app连月6"
    ElseIf guige = "ap3" Then 
        guigepic = "app连季"
        guigepic2 = "app连季2"
        guigepic3 = "app连季3"
        guigepic5 = "app连季5"
        guigepic6 = "app连季6"
    ElseIf guige = "ap12" Then 
        guigepic = "app连年"
        guigepic2 = "app连年2"
        guigepic3 = "app连年3"
        guigepic5 = "app连年5"
        guigepic6 = "app连年6"
    End If
    runapp "com.kugou.android"
    Delay 1000
    Do
        For 35
            Call 找图(0, 0, 0, 0, "app连月")
            If x > 0 Then 
                TracePrint x&","&y
                tap x,y
                Exit do
            End If
            Call 找图(0, 0, 0, 0, "app连月1")
            If x > 0 Then 
                TracePrint x&","&y
                tap x,y
                Exit do
            End If
            Call 找图(0, 0, 0, 0, "app连月2")
            If x > 0 Then 
                TracePrint x&","&y
                tap x,y
                Exit do
            End If
            Call 找图(0, 0, 0, 0, "app连月3")
            If x > 0 Then 
                TracePrint x&","&y
                tap x,y
                Exit do
            End If
            Call 找图(0, 0, 0, 0, "app连月5")
            If x > 0 Then 
                TracePrint x&","&y
                tap x,y
                Exit do
            End If
            Call 找图(0, 0, 0, 0, "app连月6")
            If x > 0 Then 
                TracePrint x&","&y
                tap x,y
                Exit do
            End If
            Call 找图(0, 0, 0, 0, "app连月7")
            If x > 0 Then 
                TracePrint x&","&y
                tap x,y
                Exit do
            End If
            找图 0,0,0,0, "送四大会员"
            If x > 0 Then 
                Tap x+50,y+50 
                Exit do
            End If
            找图 0,0,0,0, "免费升级超会1"
            If x > 0 Then 
                Tap x+50,y+50     
                Exit do
            End If
            关闭广告
            Delay 200 
        Next     
        Delay 100
        到豪华价格界面
    Loop
    
    
    If guige = "hhsj" Then 
        //直接升级超级会员
    Else 
        goto tghhsja
    End If
    
    Do  	
        For 15
            找图 0,0,0,0, "送四大会员"
            If x > 0 Then 
                Tap x+50,y+50 
                Exit do
            End If
            找图 0,0,0,0, "免费升级超会1"
            If x > 0 Then 
                Tap x+50,y+50     
                Exit do
            End If
        Next
        Delay 200
    Loop
    找图 0, 0, 0, 0, "免费升级超会1"
    If x > 0 Then 
        If mfsj = true Then 
            TracePrint "有免费升级超级会员，已勾选"
        Else 
            TracePrint "取消免费升级超级会员"
            Call 找图(0, 0, 0, 0, "免费升级超会")
            Tap x, y
            Delay 500
                
        End If
    End If
    goto 跳过查找
    
    rem tghhsja
    Delay 500
    If guige = "ap1" Then 
        Call 找图(0, 0, 0, 0, "免费升级超会1")
        If x > 0 Then 
            If mfsj = true Then 
                TracePrint "有免费升级超级会员，已勾选"
            Else 
                TracePrint "取消免费升级超级会员"
                Call 找图(0, 0, 0, 0, "免费升级超会")
                Tap x, y
                Delay 500
                
            End If
        End If
        Goto 跳过查找
    End If
    For 5
        Call 找图(0,0,0,0,guigepic)
        If x > 0 Then 
            Tap x, y
            Delay 200
            Exit for
        End If 
        Call 找图(0,0,0,0,guigepic2)
        If x > 0 Then 
            Tap x, y
            Delay 200
            Exit For
        End If
        Call 找图(0,0,0,0,guigepic3)
        If x > 0 Then 
            Tap x, y
            Delay 200
            Exit For
        End If
        Call 找图(0,0,0,0,guigepic5)
        If x > 0 Then 
            Tap x, y
            Delay 200
            Exit For
        End If
        Call 找图(0,0,0,0,guigepic6)
        If x > 0 Then 
            Tap x, y
            Delay 200
            Exit For
        End If 
        TracePrint "选择"&guigepic&"，往左滑动1格"
        TouchDown 400, 518, 1
        Delay 100
        TouchMove 168, 518, 1, 300
        Delay 200
        TouchUp 1
        Delay 500
    Next
    rem 跳过查找
    Delay 500
    For 15
        Call 找色(9,1054,90,1117,"89C5EE")
        If x > 0 Then 
            TracePrint "同意已勾选"
            Exit for
        Else 
            TracePrint "点击勾选同意"
        End If
        Tap 46, 1087
        Delay 500
    Next
    Delay 300
    TracePrint "点确认协议并支付"
    Tap 529, 1181
    Delay 1000
    Rem 回app重新点
    
    Do
        For 15
            Call 找图(0, 0, 0, 0, "付款支付宝2")
            If x>0 Then 
                TracePrint "点支付宝付款"
                tap x,y
                Exit do
            End If
            Delay 100
        
            Call 找图(0, 0, 0, 0, "付款支付宝")
            If x>0 Then 
                TracePrint "点支付宝付款"
                tap x,y
                Exit do
            End If
            Delay 100
        Next
        
        Delay 200
        goto 重新打开
        TracePrint "没找到支付宝付款"
    Loop
    Delay 2000
    Do
        For 20
            找图(0,0,0,0,"付款并开通免密支付2")
            If x>0 Then  
                TracePrint "进入支付宝了"
                Delay 1000
                Exit Do
            End If
            Delay 500
            找图(0,0,0,0,"app-zfb-确认付款")
            If x>0 Then  
                TracePrint "进入支付宝了"
                Delay 1000
                Exit Do
            End If
            Delay 500
        Next
        找图(0, 0, 0, 0, "苹果续费")
        If x>0 Then 
            TracePrint "点支付宝付款"
            苹果续费 = "已开启"
            充值失败 = true
            email = "【充值失败,有苹果续费】" &pxtype& "wp1:" & wp1 & ",ap1:" & ap1 & ",cj1:" & cj1&",wp3:"&wp3&",wp12:"&wp12&",jyq:"&jyq&",会员状态:"&会员状态&",会员信息:"&会员信息
            status id, "失败", 2, email
            RestartScript
        End If
        RunApp kg
        Delay 500
        goto 回app重新点
        
        TracePrint "没找到付款并开通免密支付按钮"
    Loop
    支付对象="app"
    run (code)
End Function
Function 到豪华价格界面
    Dim pageTry
    If jyq = "有券" or jyq = "无券" Then
        KeyPress "back"
        Delay 700
        Tap 419,1223
        Delay 1000
        For pageTry = 1 To 3
            If 等待任一图片(0,0,0,0,"确认协议|豪华协议优惠小字|超级确认协议",15,250,"豪华价格-券后入口") = 1 Then
                If 等待命中图 = "确认协议" or 等待命中图 = "豪华协议优惠小字" Then Exit Function
                Tap 115,293
                Delay 700
                If 等待任一图片(0,0,0,0,"确认协议|豪华协议优惠小字",10,200,"豪华价格-切换豪华") = 1 Then Exit Function
            End If
            等待状态回传 "豪华价格-券后入口", "第" & pageTry & "次重新导航价格页"
            到价格界面
        Next
        等待致命失败 "豪华价格-券后入口", "确认协议|豪华协议优惠小字"
    End If

    For pageTry = 1 To 3
        Tap 115,293
        Delay 700
        If 等待任一图片(0,0,0,0,"确认协议|豪华协议优惠小字",12,200,"豪华价格-确认页") = 1 Then Exit Function
        等待状态回传 "豪华价格-确认页", "第" & pageTry & "次重新进入价格页"
        到价格界面
    Next
    等待致命失败 "豪华价格-确认页", "确认协议|豪华协议优惠小字"
End Function
Function 同步书签
    Dim flowTry
    If tbsq <> "1" Then Exit Function

    TracePrint "去同步书签一次"
    For flowTry = 1 To 3
        RunApp qk
        Delay 1000
        If 等待任一图片(0,0,0,0,"qk主界面|夸克主页",8,200,"同步书签-夸克主页") = 1 Then
            If 等待命中图 = "夸克主页" Then Tap x,y : Delay 300
            Tap 97,700
            TracePrint "点击书签"
            Delay 700
            If 等待任一图片(207,70,356,149,"书签",10,200,"同步书签-书签页") = 1 Then
                If TryTapPic(15,1182,424,1276,"书签同步",0,0,300,"点击书签同步") = 0 Then TracePrint "未发现书签同步按钮，可能已经同步"
                Exit Function
            End If
        End If
        等待状态回传 "同步书签", "第" & flowTry & "次导航失败，重启夸克后从主页重试"
        执行等待恢复 "重启夸克"
    Next
    等待致命失败 "同步书签", "qk主界面|书签"
End Function
Function 续费跳支付宝(t)'"t"为页面价格，用于与支付金额c核对确认

    If zfbxy = False or 苹果续费状态="true" Then 
    Else 
        TracePrint"启动支付宝"
        RunApp "com.eg.android.AlipayGphone"
        Delay 1500
    End If
    
    Delay 1000
    TracePrint "再次核对支付的金额"
    Rem 重新识别
    Do
        For 5
           
            找图(0,0,0,0,"付款并开通免密支付2")
            If x>0 Then 
                Tap x,y
                Delay 2000
            End If
            Delay 200
            找图(0,0,0,0,"支付宝确认继续")
            If x>0 Then 
                Tap x,y
                Delay 2000
            End If
            Delay 200
            Call 找图(0,0,0,0, "支付宝米3")
            If x > 0 Then 
                TracePrint x&","&y
                Delay 500
                Exit Do
            End If
            Delay 200
            Call 找图(0,0,0,0, "支付宝米5")
            If x > 0 Then 
                TracePrint x&","&y
                x = x - 4
                y = y - 3
                Delay 500
                Exit Do
            End If
            Delay 200
            找图 0,0,0,0, "15元支付宝米5"
            If x > 0 Then 
                x = x - 5
                y=y-2
                Exit Do
            End If
            Delay 200
        Next
        Delay 100
        email="进入支付宝没有找到订单信息"&","&code
        status id, "卡了", 2, email
        返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续；取消：结束脚本",1)
        TracePrint 返回条件
        If 返回条件 = 0 Then ShowMessage "确定，继续"
        If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
    Loop
    TracePrint "textocr:"&Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)
    ocr8=Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)
    ocr8 = Replace(ocr8, "oo", "00")
    ocr8=Replace(ocr8, "o", "0")
    TracePrint "OcrText:" &ocr8
    
    If IsNumeric(ocr8) = true Then 
        zfbp = CDbl(Abs(ocr8))	
        TracePrint "text支付金额:" &zfbp
    Else 
        ocr8 = SmartOcr(x + 45, y - 20, 550, y + 61)
        TracePrint "SmartOcr:" &ocr8
        TracePrint ocr8
        ocr8 =CDbl(ocr8)
        If ocr8 <> "" Then 
            If ocr8 > 0 Then 
                zfbp = CDbl(Abs(ocr8))		
                TracePrint "SmartOcr:" &zfbp
            Else 
                TracePrint "识别出错" &zfbp    	
            End If
        End If       
    End If
    Delay 200
    TracePrint zfbp
   

    If t = 0.88 and zfbp = 088 Then 
        TracePrint "识别出错，重新定义c"
        zfbp=0.88
    ElseIf t = 4.8 and zfbp = 48 Then 
        TracePrint "识别出错，重新定义c"
        zfbp=4.8
    ElseIf t = 3.8 and zfbp = 38 Then
        TracePrint "识别出错，重新定义c"
        zfbp = 3.8
    ElseIf t = 3.8 and zfbp = 300 Then
        TracePrint "识别出错，重新定义c"
        zfbp = 3.8
    ElseIf t = 6 and zfbp = 300 Then
        TracePrint "识别出错，重新定义c"
        zfbp = 6
    ElseIf t = 6 and zfbp = 600 Then
        TracePrint "识别出错，重新定义c"
        zfbp=6
    ElseIf t = 7.5 and zfbp = 75 Then
        TracePrint "识别出错，重新定义c"
        zfbp=7.5
    ElseIf t = 2.8 and zfbp = 28 Then 
        TracePrint "识别出错，重新定义c"
        zfbp=2.8
    ElseIf t = 1.88 and zfbp = 188 Then
        TracePrint "识别出错，重新定义c"
        zfbp = 1.88
    ElseIf t = 8 and zfbp = 800 Then
        TracePrint "识别出错，重新定义c"
        zfbp = 8
    ElseIf t = 1.88 and zfbp = 1188 Then
        TracePrint "识别出错，重新定义c"
        zfbp = 1.88
    ElseIf t = 9.9 and zfbp = 919 Then
        TracePrint "识别出错，重新定义c"
