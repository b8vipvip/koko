                找图 0, 0, 0, 0, "via价格界面"                
                If find=True Then 
                    TracePrint "via价格界面"
                    Exit Do
                End If
                Delay 200 
                找图 0, 0, 0, 0, "via价格界面2"                
                If find=True Then 
