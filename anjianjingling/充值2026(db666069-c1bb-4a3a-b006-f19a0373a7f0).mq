        If x>0 Then
            TracePrint "跳到设置页面"
            Delay 300
            Tap x, y
            Exit For
        Else 
            TracePrint "没找到设置"
        End If
        关闭广告 
        找图(1,52,147,153,"推荐")
        If x>0 Then 
            TracePrint "在推荐页"
            Delay 800
            TracePrint "点三条杠"
            Tap 676, 105
        End If
        
        
        Delay 500
    Next
    Delay 500
    For 5
        临时=xdpub.元素查找({"resource-id":"android:id/summary","text":"个人信息、账号绑定、隐私设置"})
        If 临时 Then
            TracePrint "跳到设置页面"
            Delay 300
            xdpub.元素点击(临时,200)
            Exit For
        Else 
            TracePrint "没找到设置"
        End If
        Call 找图(95,269,543,411, "个人信息")
        If x > 0 Then 
            TracePrint "个人信息"
            Delay 300
            tap x,y
            Exit For
        Else 
            TracePrint "个人信息"
            
        End If
        找图(624,57,718,157,"三条杠")
        If x>0 Then 
            TracePrint "在三条杠"
            tap x,y
        End If
        找图 572, 107, 661, 197, "设置"
        
        If x>0 Then
            TracePrint "跳到设置页面"
            Delay 300
            Tap x, y
        End If
        
        Delay 500
    Next
    Delay 500
    Do
        For i=1 to 15
            临时=xdpub.元素查找({"resource-id":"com.kugou.android:id/nc","text":"账号中心"})
            If 临时 Then
                TracePrint "跳到设置页面"
                Delay 300
           
                Exit do
            Else 
                TracePrint "没找到设置"
            End If
            Call 找图(22, 56, 320, 158, "账号中心")
            If x > 0 Then 
                TracePrint "在账户中心界面"
                Exit Do
            Else 
                TracePrint "没进入账户中心"
                
            End If
            找图 0, 0, 0, 0, "我的会员"
            If x > 0 Then 
                TracePrint "在账户中心界面"
                Exit do
            Else 
                TracePrint "没在账户中心"
            End If            
            Delay 100
            If i = 10 Then 
            	会员活动广告
            End If
        Next
        Goto 回到推荐页
    Loop
    Delay 200
    If tj = "二次" Then 
        TracePrint "跳过查会员"
        
        Exit Function
    End If
    Do
		for i=1 to 15
        FindColor 385,1194,642,1216,"948881|9E948D|C5BEBA|948881|B6AEA9|AAA09B|C0B9B5",0,0.9,x,y
        If x>0 Then
            TracePrint x&","&y
            TracePrint "会员状态非空白"
            Exit Do
        Else 
            TracePrint "会员状态是空白"
        End If
        Delay 200
        If i = 10 Then 
        	会员活动广告
        End If
        next 
    loop

    Do
    	for i=1 to 15
        提取文本("android.widget.TextView", "com.kugou.android:id/dro", "", 1190, 639, 1220,"","yes")
        If text1 = "开通豪华VIP，立赠音乐包" Then 
            TracePrint "非会员状态"
            会员状态 = "未开通"
            会员信息="/"
            豪华天数=0
            Exit do
        ElseIf xdpub.lua_正则匹配(text1, "[\128-\254][\128-\254][\128-\254]+") = "音乐包" Then
            会员类型="音乐包"
            vipdate=xdpub.lua_正则匹配(text1, "%d%d%d%d%-%d%d%-%d%d")
            TracePrint 会员类型&":"&vipdate
            音乐包天数=CDbl(zm.TimeDiff(vipdate, "日", true))
            音乐包状态="是会员"
            TracePrint 音乐包天数
            会员信息=text1
            豪华天数=0
            Exit Do
        ElseIf IsNull(xdpub.lua_正则匹配(text1, "[\128-\254][\128-\254][\128-\254]+%a%a%a")) = False Then
            会员类型=xdpub.lua_正则匹配(text1, "[\128-\254][\128-\254][\128-\254]+%a%a%a")
            vipdate=xdpub.lua_正则匹配(text1, "%d%d%d%d%-%d%d%-%d%d")
            TracePrint 会员类型&":"&vipdate
            会员信息=text1
            If 会员类型 = "豪华VIP" Then 
                豪华天数=zm.TimeDiff(vipdate, "日", true)
                豪华天数=CDbl(豪华天数)
                豪华状态="是会员"
                TracePrint 豪华天数
        	
                Exit Do
            ElseIf 会员类型 = "超级VIP" Then
                超级状态="是会员"
                豪华天数=0
            End If
            Exit Do
        Else 
            豪华天数=0
        End If
        找图 572, 107, 661, 197, "设置" 
        If x>0 Then
            TracePrint "跳到设置页面"
            
            goto 在推荐页
        End If
        Delay 200
        If i = 10 Then 
        	会员活动广告
        End If
        next
    Loop
    run (code) 
End Function

Function 提取文本(view, resourceid, left1, top1, right1, bottom1,type1,faemail)
    
    For retry = 1 To 3
        matchCount = 0
        识别 = ""
        text1=""
        TracePrint "第 " & retry & " 次查找中..."

        table = Element.Find(view, "")
        TracePrint Encode.TableToJson(table)
        Dim tablejson="["&view&","&resourceid&","&left1&","&top1&","&right1&","& bottom1&","&type1&",]"&Encode.TableToJson(table)
        For i = 1 To UBound(table) + 1
            Dim e = table[i]
            Dim 条件满足 = True

            If resourceid <> "" Then
                If e["resource-id"] <> resourceid Then 条件满足 = False
            End If
            If left1 <> "" Then
                If e["left"] <> left1 Then 条件满足 = False
            End If
            If top1 <> "" Then
                If e["top"] <> top1 Then 条件满足 = False
            End If
            If right1 <> "" Then
                If e["right"] <> right1 Then 条件满足 = False
            End If
            If bottom1 <> "" Then
                If e["bottom"] <> bottom1 Then 条件满足 = False
            End If

            If 条件满足 Then
                matchCount = matchCount + 1
                text1 = e["text"]
                TracePrint "找到目标元素，text1 = " & text1
                TracePrint "text1类型 = " & shanhai.type(text1)
                If type1 = "num" Then 
                    text1=cdbl(text1)	
                    If ShanHai.type(text1) = "number" Then 
                        TracePrint "text1类型是数值:" &text1
                        email="[正在充值]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
                        email=CStr(email)
                        status id, "充值中", 2, email
                    Else 
                        TracePrint "text1类型不是数值:" &text1
                        dim timepath= "/" & "sdcard" & "/" & "pictures" & "/"&"记录"& "/"&"ocr失败"& "/"
                        g=Replace(Replace(Replace(GetNetworkTime(), "-", ""), ":", ""), " ", "")
                        TracePrint g
                        Dim path = timepath&g&"_"&i& "." & "txt"
                        If Dir.Exist(path) = 2 Then 
           				
                        Else 
                            dim 返回值 = zm.FileCreate(path)
           				
                        End If
                        zm.FileWrite path, tablejson
                        识别 = False
                        //                        email="发现元素文本但不是数值"
                        //                        status id, "无元素", 2, email
                        TracePrint zm.VarInfo(zm.FileReadLines(path))
                    End If
                End If
                Exit For
            End If
        Next

        If matchCount > 0 Then Exit For
        timepath= "/" & "sdcard" & "/" & "pictures" & "/"&"记录"& "/"&"ocr失败"& "/"
        g=Replace(Replace(Replace(GetNetworkTime(), "-", ""), ":", ""), " ", "")
        TracePrint g
        path = timepath&g&"_"&i& "." & "txt"
        If Dir.Exist(path) = 2 Then 
           
        Else 
            返回值 = zm.FileCreate(path)
           
        End If
        zm.FileWrite path, tablejson
        TracePrint zm.VarInfo(zm.FileReadLines(path))

        TracePrint "未找到符合条件的元素，等待500ms后重试..."
        Delay 500
    Next

    If matchCount = 0 Then
        TracePrint "共重试3次，仍未找到符合条件的元素。"
        识别 = False
        email="找了3次没发现元素文本"&tablejson
        If type1 = "num" and faemail="yes" Then 
         
            //            status id, "无元素", 2, email
        ElseIf type1 = "" and faemail="yes" Then
        
            //            status id, "无元素", 1, email

        End If
    End If
End Function
Function 元素(t,d)'<d=1时点击,否则不点击>
    Delay 200
    临时 = xdpub.元素查找S({"text":t})
    If 临时 Then 
        TracePrint "找到元素："&t
        If d = 1 Then
            xdpub.元素点击(临时, 500)
        End If
    Else 
        TracePrint "没找到元素："&t
    End If
End Function
Function 找字(x,y,x1,y1,textx,d)'<d=1点击>
    TracePrint "识别到的文字:"&Image.OcrText(x,y,x1,y1, 0, 0)
    text = (textx = Image.OcrText(x, y, x1, y1, 0, 0))
    If  text= true Then 
        TracePrint "找到文字："&textx
        If d = 1 Then 
            x2 = x + (x1 - x) / 2
            y2 = y + (y1 - y) / 2
            Tap x2, y2
            TracePrint "点击文字["&textx&"]坐标："&x2&","&y2
        End If
    Else 
        TracePrint "没找到文字："&textx
    End If
End Function
Function 找图(x1,y1,x2,y2,n)
    FindPic x1, y1, x2, y2, "Attachment:" & n & ".png", "000000", 0, 0.9, x, y
    If x > 0 Then 
        TracePrint "找到[图]["&n&"]坐标为："&x&","&y
        find = True
    Else 
        TracePrint "没找到[图]["&n&"]"
        find = False
        x = -1
        y=-1
    End If
    tx = x
    ty = y
    TracePrint tx&","&ty
End Function
Function 找色(x1,y1,x2,y2,c)
    FindColor x1,y1,x2,y2,c,0,1,x,y
    If x > 0 Then 
        TracePrint "找到[颜色]["&c&"]坐标为："&x&","&y
    Else 
        TracePrint "没找到[颜色]["&c&"]"
    End If
End Function
Function 点击()
    xdpub.元素点击(临时,500)
End Function
Function 运行时长
    Dim timea,timeb
    timeend_m = DateTime.Minute()
    timeend_s = DateTime.Second()
    timea = timeend_m - timestart_m
    timeb = timeend_s - timestart_s
    
    ' 秒数为负时需要向分钟借 1，否则跨分钟会多算 1 分钟
    If timeb < 0 Then
        timeb = timeb + 60
        timea = timea - 1
    End If
    If timea < 0 Then
        timea = timea + 60
    End If
    
    timelong = timea & "分" & timeb & "秒"
    TracePrint timelong
End Function
Function 识别数字(x,y,x1,y1,xtext)
    Dim ocrText
    ocrText = Image.OcrText(x,y,x1,y1, 0, 0)
    
    If IsNumeric(ocrText) = true Then
        xname = CDbl(Abs(ocrText))
        TracePrint xtext & xname
    Else
        ocrText = SmartOcr(x,y,x1,y1)
        TracePrint ocrText
        If IsNumeric(ocrText) = true Then
            xname = CDbl(Abs(ocrText))
            TracePrint xtext & xname
        Else
            识别 = False
            TracePrint "识别出错"
        End If
    End If
End Function
Function 修正金额(t)'如果识别不符，则弹出提示

    If t = "ap1" Then 
        p=ap1 
        TracePrint "修正前ap1:"&ap1
        If p = 100 Then 
            p = 1
        ElseIf p = 5.8 Then
            p = 3.8
        ElseIf p = 108 Then
            p = 1.88
        ElseIf p = 40 Then
            p = 4.8
        ElseIf p = 3.9 Then
            p = 9.9
        ElseIf p = 38 Then
            p = 4.8
        ElseIf p = 30 Then
            p=3.8
        ElseIf p = 20 Then
            p = 2.8
        ElseIf p = 39 Then
            p=9.9
        ElseIf p = 1.33 Then
            p=1.88
        End If
        If p = 11 Then 
            TracePrint "p=11 不修正金额"
            Exit Function
        
        ElseIf p>20 and p<>88 and p<>61 Then
            ap1=abs(Left(p, 1) & "." & Mid(p, 2,3))
            TracePrint "修正后金额："&ap1
            Exit Function 
        End If
        TracePrint "修正前p:"&p
        p = Encode.TableToJson(p)
        a=UBound(p)+1
        If Len(p) >= 2 Then
            If Mid(p, 2, 1) = "1" Then
                TracePrint "修正小数点"
                p = Left(p, 1) & "." & Mid(p, 3,3)
            elseIf Mid(p, 3, 1) = "1" Then
                TracePrint "修正小数点"
                p = Left(p, 2) & "." & Mid(p, 4, 3)
            ElseIf Mid(p, 1, 1) = "6" Then
                p="6"
            End If
            If Mid(p, a, 1) = "1" Then
                TracePrint "修正最后一位数字1"
                p = Left(p, a-1)
            End If
        End If
        p = CDbl(p)
        
        TracePrint "修正后p:"&p
        Select Case p
        Case 10.5,0.88,1,1.8,1.88,2,2.8,3,3.8,3.9,4,4.8,5,5.7,6,6.8,7,7.5,8.7,8,8.8,9,9.9,10,10.8,11,12,14,13,15
