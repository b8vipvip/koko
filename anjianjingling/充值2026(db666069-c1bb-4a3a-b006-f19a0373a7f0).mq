        Exit Function
    ElseIf order_ID = "99888tvfa45805bc7c8" Then 
        order_type = "ct1"
        xps = 9.9
        oid="手动订单"
        Exit Function
    ElseIf order_ID = "149888tvfa45805bc7c8" Then 
        order_type = "ct1"
        xps = 14.9
        oid="手动订单"
        Exit Function    
    ElseIf order_ID = "99888fa45805bc7c8" Then 
        order_type = "cj1"
        xps = 9.9
        oid="手动订单"
