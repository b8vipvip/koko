    End If
    If IsNumeric(cjb) = False Then 
        cjb = 88
    End If
    If IsNumeric(cjc) = False Then 
        cjc = 88
    End If
    
    
    If cja <= cjb And cja <= cjc Then
        cj1 = cja
        '充值时选择坐标1
        cjxy=1
    ElseIf cjb <= cja And cjb <= cjc Then
        cj1 = cjb
        cjxy=2
    Else
        cj1 = cjc
        cjxy=3
       
    End If
    TracePrint "cj1最终等于:"&cj1
    run (code) 	
End Function
Function 充值超级会员(cjxyx)
    rem 重新
    tap 371,286
    Delay 1000
    Do
        For 15
            找图 305, 1116, 710, 1235, "超级确认协议"
            If x > 0 Then 
                TracePrint "进入超级会员价格界面了"
                Exit Do
            End If
        Next
        Delay 200
        到价格界面 
        tap 371,286
    Loop
    If cjxyx = "sj30" Then 
        If sj30 = 2 or sj30 = 1 Then 
            Do
                For 3
                    找图 0, 0, 0, 0, "app升级"
                    If x > 0 Then 
                        TracePrint "可以2元升级"                                                         
                        Delay 200
                        TracePrint "点升级月数"
                        
                        tap x+69,y+141
                        goto 升级2元
                    End If
                Next
                Delay 200
            Loop	
        else 
            do
                For 5
                    找图 11,334, 711,764, "超级升级30天"
                    If x > 0 Then 
                        TracePrint "找到超级升级30天"
                        Tap x, y
                        Exit Do
                    End If
                    Delay 200
                Next
            Loop
        End If
    ElseIf cjxyx = "hh3b" Then
        Tap 326, 540
    ElseIf cjxyx = "cj1" Then
        If cjxy = 1 Then 
            Tap 132,552
        ElseIf 	cjxy = 2 Then 
            Tap 326, 540
        ElseIf 	cjxy = 3 Then 
            Tap 548,534
        End If
    ElseIf cjxyx = "sjx" Then
        Tap 132,552
    End If
    Delay 1000

    Do
        For 15
            找图 305, 1116, 710, 1235, "超级确认协议"
            If x > 0 Then 
                '点同意协议
                Tap 49, 1088
    				
                Delay 500
                Tap x, y
                Delay 200
                Exit Do
            End If
        Next
        Delay 200
    Loop
    goto 开通
    
    rem 升级2元
    do
        For 5
            找图(104,744,581,1092,"升级月份")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出升级月份"
                Exit do
            End If
            Delay 100
        Next
        Delay 100
    Loop
    do
        识别数字(319, 1015, 408, 1076, "识别到当前月份为：")
        TracePrint xname
        If xname > 1 Then 
            TracePrint "减一个月"
            Tap 119, 1044
            Delay 500
        ElseIf xname < 1 Then
            Tap 602, 1040
            Delay 500
            TracePrint "减一个月"
        ElseIf xname = 1 Then
            TracePrint "月份正确，退出循环" 
            Exit do
        End If
        	
    loop
    TracePrint "月份正确，直接点升级" 
    Tap 333, 1176'点开通

    Rem 开通
    
    do
        For 5
            找图(134,761,608,934,"继续购买")
            If x > 0 Then 
                Delay 500
                Tap x,y
                TracePrint "弹出继续购买"
                Exit do
            End If
            找图(0,0,0,0,"付款支付宝")
            If x > 0 Then 
                TracePrint "弹出支付对象"
                Exit do
            End If
            找图(0,0,0,0,"付款支付宝2")
            If x > 0 Then 
                TracePrint "付款支付宝2"
                Exit do
            End If
            Delay 100
        Next
        Delay 100
    Loop
    do
        For 5
            找图(0,0,0,0,"付款支付宝")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出支付对象"
                Tap x,y
                Exit do
            End If
            Delay 100
        Next
        For 5
            找图(0,0,0,0,"付款支付宝2")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出支付对象"
                Tap x,y
                Exit do
            End If
            Delay 100
        Next
        Delay 100
    Loop
    
    Delay 1000
    
    
    do 
        For 80
            找图(0,0,0,0,"继续开通")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出继续开通"
                Tap x, y
                Delay 200
                Exit for
            End If
            临时=xdpub.元素查找({"resource-id":"toGetVipBtn","text":"继续开会员"})
            If 临时 Then 
                Delay 200
                xdpub.元素点击 临时, 300
                Exit for
            End If
            找图(0,0,0,0,"继续开通2")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出继续开通"
                Tap x, y
                Delay 200
                Exit for
            End If
            找图(0,0,0,0,"继续开通3")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出继续开通"
                Tap x, y
                Delay 200
                Exit for
            End If
            找图 0, 0, 0, 0, "未安装支付宝"
        
            If x > 0 Then 
                Delay 500
                TracePrint "弹出未安装支付宝"
                KillApp kg
                Delay 500
                RunApp kg
                Delay 1000
                到价格界面 
                Goto 重新
            End If
            找图(0,0,0,0,"付款并开通免密支付2")
            If x > 0 Then 
                
                TracePrint "付款并开通免密支付2"
                Delay 500
                Exit do
            End If
            找图 0, 0, 0, 0, "支付宝米3"
            If x > 0 Then 
                TracePrint x&","&y
                zfbxy=False
                Delay 500
                Exit Do
            End If
            Delay 200
            找图 0,0,0,0, "15元支付宝米5"
            If x > 0 Then 
                Exit Do
            End If
            找图 0, 0, 0, 0, "苹果续费"
            If x > 0 Then 
                TracePrint x&","&y
                苹果续费 = true
                email="[需要关闭苹果续费后充值]<br>["&pxtype&"][czp:"&czp&"][lp:"&lp&"][wp1:"&wp1&"][wpcj1:"&wpcj1&"][ap1:"&ap1&"][cj1:"&cj1&"]"&"[hhsj1:"&hhsj1&"][ap3:"&ap3&"]"&"[wp3:"&wp3&"]"&"[wp12:"&wp12&"]["&"ap12:"&ap12&"][sj30:"&sj30&"]"&"[jyq:"&jyq&"]"&"[swyq:"&swyq&"]"&"[hhzk3:"&hhzk3&"]"& "]豪华状态:" & 豪华状态&",超级状态"&超级状态&",会员信息:"&会员信息&",豪华天数:"&豪华天数&",苹果续费:"&苹果续费状态
                status id, "失败", 2, email
                RestartScript
            End If 
             
            Delay 500
            找图(0,0,0,0,"付款支付宝2")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出支付对象"
                Tap x,y
                Delay 2000
            End If
            Delay 500
            找图(0,0,0,0,"付款支付宝")
            If x > 0 Then 
                Delay 500
                TracePrint "弹出支付对象"
                Tap x,y
                Delay 2000
            End If
        Next
        
    loop	
    	
    run (code)	
End Function
Function 账号中心到价格界面()
    Rem 账号中心
    If 跳过 = true Then 
        Call 找图(22,1164,220,1251, "我的会员")
        If x > 0 Then 
            TracePrint "点击我的会员"
            Tap x, y
            Delay 1000
        Else 
            RunApp "com.kugou.android", "com.kugou.android.useraccount.vippage.VIPInfoChildActivity"
            Delay 1000
        End If
        goto 找礼物
    End If
    '是否在账号中心
    TracePrint "账号中心到价格界面"
    Delay 500
    Do
        for 10
            Call 找图(22,1164,220,1251, "我的会员")
            If x > 0 Then 
                TracePrint "点击我的会员"
                Tap x, y
                Delay 1000
                Exit Do
            End If
            Delay 200
        Next
        Delay 200
        TracePrint "推荐页到个人信息"
        tj = "二次"
        Call 推荐页到个人信息()
        Delay 500
    loop
    Delay 1500
    Rem 找礼物
    Do
        For 18
            '是否礼物图标
            Call 找图(17,1161,116,1263, "礼物图标")
            If x > 0 Then 
                TracePrint "进入会员界面"
                Delay 500
                Exit do
            End If
        Next
        Delay 100
        KeyPress "back"
        Delay 200
        Goto 账号中心
    Loop
    //是否已开通自动续费
    For 3
           
        找图 21,150,569,504, "已开通自动续费"
        If x > 0 Then 
            TracePrint "找到已开通自动续费"
            自动续费=true
            Exit for
        End If
        Delay 200
    Next
    
    
    
    
    
    
    Tap 140,92'点超级vip
    Delay 1000
    Do
        For 3
            '是否在豪华会员界面
            找图 0,0,0,0,"超级50加"
            If x > 0 Then 
                TracePrint "进入豪华会员界面"
                Exit do
            End If
            FindPic 0,0,0,0, "Attachment:超级50加.png", "000000", 0, 0.9, x, y
            If x > 0 Then 
                TracePrint "进入豪华会员界面"
                Exit do
            End If
            Delay 100
        
            找图 0,0,0,0,"超级界面超级VIP"
            If x>0 Then 
                TracePrint "进入超级会员界面"
                Exit do
            End If
            找图 0,0,0,0,"豪华界面超级VIP"
            If x>0 Then 
                TracePrint "进入超级会员界面"
                Tap x+20,y+20
            End If
            TracePrint "没在超级会员界面"
        
        Next
        
        
        
        
        TracePrint "没在超级会员界面"
        goto 找礼物
    loop

    Tap 297,87'点豪华vip
    Delay 1000
    do
        For 5
            '是否在豪华会员界面
            Call 找色(401,240,480,271, "8FD6FF|87D3FF|84D1FF")
            If x > 0 Then 
                TracePrint "进入豪华会员界面"
                Delay 1000
                Tap 564,419'点开通
                Delay 500
                Exit do
            End If
        Next
        goto 找礼物
    loop
    Delay 3500
    Rem 找红包
    Do
        For 5
            Call 找图(0,0,0,0, "确认协议")
            If x > 0 Then  
                TracePrint "进入会员价格"
                Delay 500
                Exit do
            End If
            Call 找图(0,0,0,0, "豪华协议优惠小字")
            If x > 0 Then  
                TracePrint "进入会员价格"
                Delay 500
                Exit do
            End If
        Next
        For 5
            '是否有价格红包
            Call 找图(169,697,562,846, "app价格红包")
            If x > 0 Then 
                TracePrint "出现红包"
                Delay 1000
                Tap x,y'点使用
                Delay 2000
                Exit For
            Else 
                TracePrint "没出现红包"
            End If
            Delay 100
        Next
        Delay 100
    loop
    Do
        For 20
            '是否在豪华价格界面
            Call 找图(0,0,0,0, "确认协议")
            If x > 0 Then  
                TracePrint "进入会员价格"
                Delay 500
                Exit do
            End If
            Call 找图(0,0,0,0, "豪华协议优惠小字")
            If x > 0 Then  
                TracePrint "进入会员价格"
                Delay 500
                Exit do
            End If
        Next
        '是否在上一个界面
        Call 找色(401,240,480,271, "8FD6FF|87D3FF|84D1FF")
        If x > 0 Then 
            TracePrint "进入豪华会员界面"
            Delay 500
            Tap 564,419'点开通
            Delay 3500
            goto 找红包
        End If
        goto 账号中心
    Loop
    run (code)
End Function
Function 关闭续费(g)
    If g = 2 Then 
        TracePrint "重新到vip界面"
    ElseIf g = 1 Then
     
        Goto 充值前
    End If
    RunApp kg
    Delay 300
    For 3
        找图 0, 0, 0, 0, "我的会员"
        If x > 0 Then 
            Tap x, y
        
