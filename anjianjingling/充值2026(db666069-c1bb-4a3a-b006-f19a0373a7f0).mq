                    Delay 1000
                    Exit Do
                End If
                Delay 200
                找图(0,0,0,0,"app-zfb-确认付款")
            			If x>0 Then  
                			TracePrint "支付宝是待支付"
                			Delay 500
                			Exit Do
            			End If
            			Delay 200
                找图 0,0,0,0, "web生成订单失败"
                If find=True Then 
                    Delay 1000
                End If
                Delay 800
                找图(0,0,0,0,"via打开支付宝")
                If find=True Then  
                    TracePrint "via允许打开支付宝"
                    tap tx,ty
                    Delay 100
                End If
                Delay 200
                找图(0,0,0,0,"via允许打开支付宝")
                If find=True Then  
                    TracePrint "via允许打开支付宝"
                    tap 531,1016
                    Delay 2000
                End If
				Delay 200
				找图 0,0,0,0, "支付宝自动跳开通成功界面 "
                If find=True Then 
                    KeyPress "Back"
                End If
                Delay 800
            Next
            
            TracePrint "没找到付款并开通免密支付按钮"
        Loop
        续费跳支付宝 (wp1)
        支付密码()
    Next
    超级升级(3) 
    续费跳支付宝(12)
    支付密码	   
End Function
Function ai识图(x1,y1,x2,y2,t)
    g=Replace(Replace(Replace(GetNetworkTime(), "-", ""), ":", ""), " ", "")
    TracePrint g
    dim timepath = "/" & "sdcard" & "/" & "pictures" & "/" & "ocr_yz" & "/"  
    jietu = timepath & g & "_" & account & "." & "png"   
    SnapShot jietu, x1,y1,x2,y2
    //	jietu = timepath & "20260513103657_3794503145.png"
    task = Encode.TableToJson(t)
    ret = URL.Get("http://127.0.0.1:5000/analyze_image?img=" & jietu & "&task=" & task, 120)
    TracePrint ret
    ' 关键：把结果返回给外面的 ret
    ai识图 = ret
End Function
Function 充值方式二(x)'wpcj直接开通超级
