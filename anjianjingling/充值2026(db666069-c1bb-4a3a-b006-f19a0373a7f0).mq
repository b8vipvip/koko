Function status(id,r_status,c_status,details)
    If 充值失败 = true Then 
        email=code&"【充值失败】"&CStr(手机号) & "," & CStr(验证码)&","&details
        发邮件(email)
        //        截图 "失败"
        
    ElseIf 验证码1 = False Then
        email=code&"【验证码失效】"&CStr(手机号) & "," & CStr(验证码)
        发邮件(email)
    ElseIf r_status = "卡了" Then
        email=code&"【卡了】"&CStr(手机号) & "," & CStr(验证码)&","&details
        发邮件(email)
        截图"价格页面"
    ElseIf r_status = "无元素" Then
        email=code&"【无元素】"&CStr(手机号) & "," & CStr(验证码)&","&details
        发邮件(email)
        截图"ocr失败"
    End If
    
    dim post数据,返回值
    Dim detail=CStr(details)  & "," & CStr(手机号) & "," & CStr(验证码) & "," & CStr(多账户) & "," & CStr(pxtype)& "," &CStr(GetNetworkTime()) &",设备:"&code&",订单号:"&oid
    post数据 = id&","&r_status&","&c_status&","&detail
    
    TracePrint "更新返回值"
    返回值 = Url.Post("http://127.0.0.1:5000/update_re_status", Post数据)
    TracePrint 返回值
End Function
Function cstatus(ids)
    Dim post数据,返回值,k,v,新状态
    post数据 = ids
    TracePrint "刷新c_status"
    返回值 = Url.Post("http://127.0.0.1:5000/c_status", post数据)
    TracePrint 返回值
    
    If 返回值 = "" Then
        TracePrint "c_status接口无返回，保留原状态：" & c_status
        Exit Function
    End If
    
    返回值 = Encode.JsonToTable(返回值)
    新状态 = ""
    For Each k , v In 返回值
        If CStr(k) = "c_status" or CStr(k) = "status" Then
            新状态 = v
            Exit For
        ElseIf IsNumeric(v) Then
            新状态 = v
        ElseIf IsNumeric(k) Then
            新状态 = k
        End If
    Next
    
    If IsNumeric(新状态) Then
        c_status = CInt(新状态)
        TracePrint "最新c_status=" & c_status
    Else
        TracePrint "无法解析c_status，保留原状态：" & c_status
    End If
End Function
