        找图 0,0,0,0, "15元支付宝米5"
        If x > 0 Then 
            x = x - 5
            y=y-2
            Exit Do
        End If
        Delay 300
    loop
     
    If IsNumeric(Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)) = true Then 
        hhzkp = CDbl(Abs(Image.OcrText(x + 45, y-20, 550, y+61, 0, 0)))	
        TracePrint "支付金额:" &hhzkp
    
    Else
        TracePrint smartocr(x + 45, y-20, 550, y+61)
        If IsNumeric(SmartOcr(x + 45, y-20, 550, y+61)) = true Then 
            hhzkp = CDbl(Abs(SmartOcr(x + 45, y-20, 550, y+61)))	
            TracePrint "支付金额:" &hhzkp
       
        Else 
            TracePrint "识别出错，自定义支付金额:" &hhzkp
        End If
    End If
    p = hhzkp     
    Dim s, pos, prefix
    s = CStr(p)
    ' 找到第一次出现 "100" 的位置
    pos = InStr(1, s, "100")
    pos=pos-1
    If pos > 0 Then
        ' 取 "100" 之前的所有字符
        prefix = Left(s, pos)
    Else
        ' 没找到 "100" 就按原值处理（看你需要也可以置 0）
        prefix = s
    End If
    TracePrint "提取结果prefix:" & prefix
    p = CDbl(prefix)
    hhzkp = p
    TracePrint hhzkp
    If hhzkp = 15100 Then 
        hhzkp=15
    End If
    If hhzkp <> 15 Then 
        TracePrint "金额不对，不等于15"
        email=code&"金额不对，不等于15"
        status id, "卡了", 2, email
        返回条件 = Dialog.MsgBox("金额不正确\n\n确定：继续支付；取消：结束脚本",1)
        TracePrint 返回条件
        If 返回条件 = 0 Then ShowMessage "确定，继续支付"
        If 返回条件 = 1 Then ShowMessage "取消支付，停止脚本":ExitScript
        Delay 500 
    End If
    do
        For 35
         
            找图 0,0,0,0,"支付宝确认付款2"
            If x > 0 Then 
                Tap x, y
                Delay 500
                Exit do
                    
            End If
            Delay 200
            
        Next
        Delay 200
    Loop
    Delay 200
    appzf=true
    run (code)
End Function
Function 豪华抽奖充值(hhzkx)
    RunApp via
    Delay 500
    
    Do
	
        For 15
            找图 0, 0, 0, 0, "豪华抽奖页面2"
            If x > 0 Then 
                TracePrint "yes"
                If hhzkx = 12 Then 
                    Tap 515, 747
                    Goto 开通
                    Exit Do
                End If
                Exit Do
            End If
            Delay 200
            找图 0, 0, 0, 0, "豪华抽奖重新支付"
            If x > 0 Then 
                tap x,y
                Exit Do
            End If
            找图 0, 0, 0, 0, "幸运抽奖米2"
            If x > 0 Then 
                If hhzkx = 12 Then 
                    Goto 开通
                    Exit Do
                End If 
                Tap 588, 540
                Delay 500
                Exit Do
            End If
            Delay 200
        Next
        Delay 200
        zm.OpenURL url_xycj
        Delay 2000
    Loop


    
    Rem 重新找豪华vip图标
    If hhzkx = 3 Then 
        
        Do
	
            For 5
                找图 0, 0, 0, 0, "豪华折扣开通会员"
                If x > 0 Then 
                    TracePrint "yes"
                    Delay 200
                    Tap x, y
               		
                    Exit Do
                End If
                找图 0, 0, 0, 0, "抽奖豪华季"
                If x > 0 Then 
                    TracePrint "yes"
                    Delay 200
                    '滑动页面
                    TouchDown 358, 855, 1
                    Delay 100
                    TouchMove 358,655, 1, 500
                    Delay 200
                    TouchUp 1
                    Exit Do
                End If
                找图 0, 0, 0, 0, "抽奖豪华季1"
                If x > 0 Then 
                    TracePrint "yes"
                    Delay 200
                    '滑动页面
                    TouchDown 358, 855, 1
                    Delay 100
                    TouchMove 358,655, 1, 500
                    Delay 200
                    TouchUp 1
                    Exit Do
                End If                  
            Next   
            '滑动页面
            TouchDown 358, 855, 1
            Delay 100
            TouchMove 358,600, 1, 500
            Delay 200
            TouchUp 1
            Delay 300

            Delay 200
