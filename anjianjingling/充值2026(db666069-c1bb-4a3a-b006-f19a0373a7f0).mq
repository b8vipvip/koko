            End If
            Delay 200
        Next
        TracePrint "点击去赠送"
        Tap 612, 497
        Delay 500
    Loop
    
    Dim y3,y4
    y3 = 376
    y4 = 478

    For 10
        ' 先找第1张券
        Call 找图(511, y3, 683, y4, "立即送出")
        If x > 0 Then
            TracePrint "找到立即送出"
            Tap x, y
            Delay 500
            Call 分享()
            code1 = Sys.GetClipText()
            TracePrint "code1:"&code1
            KillApp via
            Delay 200
            RunApp kg
            Delay 1000
            Do
                For 10
                    找图 0, 0, 0, 0, "app我的卡券"
                    If x>0 Then 
                        Delay 500
                        Exit Do
                    End If
                    Delay 200
                Next
                RunApp kg
                Delay 1000
            Loop
            ' 循环找剩下4张券
            For i = 1 To 4
                Call 找图(511, y3 + 193*i, 683, y4 + 193*i, "立即送出")
                If x > 0 Then
                    TracePrint x & "," & y
                    Tap x, y
                    Delay 500
                    Call 分享()
                    Select Case i
                    Case 1: code2 = Sys.GetClipText()
                    Case 2: code3 = Sys.GetClipText()
                    Case 3: code4 = Sys.GetClipText()
                    Case 4: code5 = Sys.GetClipText()
                    End Select
                    TracePrint "code"&i+1&":"&Sys.GetClipText()
                    KillApp via
                    Delay 200
                    RunApp kg
                    Delay 1000
                    Do
                        For 10
                            找图 0, 0, 0, 0, "app我的卡券"
                            If x>0 Then 
                                Delay 500
                                Exit Do
                            End If
                            Delay 200
                        Next
                        RunApp kg
                        Delay 1000
                    Loop
                Else
                    TracePrint "没找到券" & (i + 1)
                End If
                Delay 100
            Next

            code_upload_batch
            Exit For
        Else
            TracePrint "没找到立即送出"
        End If

        KeyPress "back"
        Delay 500
        Tap 608, 477
        Delay 1500
    Next

    run (code)
End Function

Function 截图(i)'变量i是命名的后缀，0代表充值前，1代表充值后
    g=Replace(Replace(Replace(GetNetworkTime(), "-", ""), ":", ""), " ", "")
    TracePrint g

    dim timepath= "/" & "sdcard" & "/" & "pictures" & "/"&"记录"
    dim timepaths=timepath&"/" & "充值成功" 
    dim timepathf=timepath&"/" & "充值失败"   
    
    If Dir.Exist(timepath) = 2 Then 
        TracePrint timepath
    Else 
        dim 返回值 = Dir.Create(timepath)
       
    End If 
    If i = "充值前" or i = "充值成功" or i = "确认账号" or i = "确认多账号" Then   
        If Dir.Exist(timepaths) = 2 Then 
           
        Else 
            返回值 = Dir.Create(timepaths)
           
