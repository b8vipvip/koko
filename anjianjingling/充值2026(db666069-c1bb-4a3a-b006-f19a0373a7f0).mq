                    Delay 100
                End If
                Delay 200
                找图(0,0,0,0,"via允许打开支付宝")
                If find=True Then  
                    TracePrint "via允许打开支付宝"
                    tap 531,1016
                    Delay 2000
                End If
				Delay 200
				找图 0,0,0,0, "支付宝自动跳开通成功界面 "
                If find=True Then 
                    KeyPress "Back"
                End If
                Delay 800
            Next
            
            TracePrint "没找到付款并开通免密支付按钮"
        Loop
        续费跳支付宝 (wp1)
        支付密码()
    Next
	
		   
End Function
Function 提取订单号(url)
    Dim p1, p2, s

    '① 编码形式 out_trade_no%253D
    p1 = InStr(1, url, "out_trade_no%253D")
    If p1 > 0 Then
        p1 = p1 + Len("out_trade_no%253D")
        s = Mid(url, p1, Len(url) - p1 + 1)

        p2 = InStr(1, s, "%2526")
        If p2 > 0 Then
            提取订单号 = Left(s, p2 - 1)
        Else
            提取订单号 = s
        End If
        Exit Function
    End If

    '② 普通形式 out_trade_no=
    p1 = InStr(1, url, "out_trade_no=")
    If p1 > 0 Then
        p1 = p1 + Len("out_trade_no=")
        s = Mid(url, p1, Len(url) - p1 + 1)

        p2 = InStr(1, s, "&")
        If p2 > 0 Then
            提取订单号 = Left(s, p2 - 1)
        Else
            提取订单号 = s
        End If
        Exit Function
    End If

    提取订单号 = ""
End Function
Function 支付密码()
    Delay 2500
    Select Case code
    Case 157: ph157
    Case 178: ph178
    Case 188: ph188
    Case 198: ph198
    Case 208: ph208
    Case 308: ph308
    End Select
    Delay 1000
    //判断是否支付完成
    Do
        For 35
            临时 = xdpub.元素查找({"text":"支付成功"})
            If 临时 Then 
                TracePrint "支付成功"
                支付界面=true
                
                截图("特殊界面")
                Exit Do
            Else 
                TracePrint "支付不成功"
            End If
            
            Delay 200
        Next

       
    Loop
    临时 = xdpub.元素查找({"text":"完成"})
    If 临时 Then 
        TracePrint "点击完成"
        Call 点击()
    Else 
        TracePrint "没找到完成按钮"
    End If
    Delay 1500
    For 3
        找图 0, 0, 0, 0, "升级弹窗"
        If find=true Then 
            run (code)
            Exit Function
        End If
        Delay 200
    Next
    If 支付对象 = "app" Then
        TracePrint "返回2次"
        BackN 2, 200
    ElseIf 支付对象 = "web" Then
        RunApp kg
        TracePrint "返回2次"
        BackN 2, 200
    End If
    If 赠送券 = true Then
        TracePrint "返回2次"
        BackN 2, 200
    End If
    run (code)
End Function
Function appdl()
    Dim loginTry,pageTry,ok
    初始化流程

    必须等待界面 54,136,333,253,"验证码登录",8,250,2,"重启酷狗","APP登录-验证码页"

    ' 同意勾选必须确认，避免未勾选导致登录按钮无效
    For loginTry = 1 To 15
        找色 194,1148,237,1187,"FF9203|FF9100|FF9101"
        If x > 0 Then Exit For
        Tap 211,1169
        Delay 200
    Next
    If x <= 0 Then 等待致命失败 "APP登录-同意协议", "协议勾选颜色"

    Tap 290,333
    Delay 300
    InputText 手机号
    Delay 300
    Tap 259,474
    Delay 300
    InputText 验证码
    Delay 300
    Tap 334,718
    TracePrint "已提交APP登录"

    ' 最多等待约30秒。只有验证码页消失或明确出现后续页面才视为登录成功。
    For loginTry = 1 To 60
        If 静默找图(290,410,542,562,"app验证码失效") = 1 Then
            验证码1 = False
            email = "登录失败，超过验证码使用次数，需重新发验证码,wp1:" & wp1 & ",wp3:" & wp3 & ",wp12:" & wp12 & "," & code
            status id,"验证失效",2,email
            uporderid_status oid,"验证失效"
            KillApp kg
            ord_result oid,"码失效"
            RestartScript
        End If

        If 静默找图(0,0,0,0,"未输入手机号") = 1 Then
            Tap 290,333
            Delay 300
            InputText 手机号
            Delay 300
            Tap 334,718
        End If

        ok = 等待任一图片(0,0,0,0,"推荐|请选择您要登录的账号|登录界面|登录界面2",1,0,"APP登录-结果")
        If ok = 1 Then Exit For

        ' 验证码登录页已经消失，也允许进入后续多账户/推荐页确认阶段
        If 静默找图(54,136,333,253,"验证码登录") = 0 Then Exit For
        Delay 500
    Next
    If loginTry > 60 Then 等待致命失败 "APP登录-提交后等待", "推荐|请选择您要登录的账号"

    判断多账户
    Delay 800

    For pageTry = 1 To 3
        For loginTry = 1 To 20
            临时 = xdpub.元素查找S({"text":"请选择您要登录的账号"})
            If 临时 Then 判断多账户 : Delay 500

            If 静默找图(0,0,0,0,"请选择您要登录的账号") = 1 Then 判断多账户 : Delay 500

            If 静默找图(1,52,147,153,"推荐") = 1 Then
                TracePrint "APP登录成功，已到推荐页"
                tj = "首次"
                Exit Function
            End If

            If 等待任一图片(0,0,0,0,"登录界面|登录界面2",1,0,"APP登录-失效检查") = 1 Then
                验证码1 = False
                email = "选择多用户后验证码失效"
                status id,"验证错",2,email
                uporderid_status oid,"验证失效"
                KillApp kg
                ord_result oid,"码失效"
                RestartScript
            End If

            关闭广告
            Delay 300
        Next
        等待状态回传 "APP登录-推荐页", "未确认推荐页，第" & pageTry & "次重启酷狗"
        执行等待恢复 "重启酷狗"
    Next

    等待致命失败 "APP登录-推荐页", "推荐"
End Function
Function 初始化流程()
    Dim initStage,ok
    TracePrint "==== 初始化酷狗登录环境 ===="
    Sys.ClearAppCache "com.kugou.android"
    Delay 500

    RunApp "com.phoneinfo.changerpro"
    Delay 800
    必须等待界面 2,1008,313,1172,"备份当前信息",5,200,2,"重启改机","初始化-改机主页"
    必须点击图片 57,932,363,1052,"全部随机",0,0,5,200,300,2,"重启改机","初始化-全部随机"
    必须点击图片 367,943,679,1060,"应用",0,0,5,200,300,2,"重启改机","初始化-应用信息"

    RunApp kg
    TracePrint "启动酷狗"
    Delay 800

    ' 同意页可能被版本升级跳过，因此允许直接命中后续页面
    ok = 必须等待界面(0,0,0,0,"app同意|app跳过|app手机登录|手机登录1|手机登录2|验证码登录",10,300,2,"重启酷狗","初始化-启动页")
    If 等待命中图 = "app同意" Then
        Tap x,y
        Delay 500
    End If

    ' 跳过页是可选状态；如果已经到登录页则直接进入下一阶段
    ok = 等待任一图片(0,0,0,0,"app跳过|app手机登录|手机登录1|手机登录2|验证码登录",10,300,"初始化-跳过页")
    If ok = 0 Then
        提取文本 "android.widget.Button", "com.kugou.android:id/bhi", 579, 40, 681, 101,"","yes"
        If text1 = "跳过" Then
            Tap 630,67
            Delay 500
        Else
            等待致命失败 "初始化-跳过页", "app跳过|app手机登录|手机登录1|手机登录2|验证码登录"
        End If
    ElseIf 等待命中图 = "app跳过" Then
        Tap x+50,y+30
        Delay 500
    End If

    ' 手机登录入口同样可能已经被跳过
    ok = 等待任一图片(0,0,0,0,"app手机登录|手机登录1|手机登录2|验证码登录",10,250,"初始化-手机登录入口")
    If ok = 0 Then
        临时 = xdpub.元素查找S({"text":"手机登录"})
        If 临时 Then
            xdpub.元素点击(临时,200)
            Delay 500
        Else
            等待致命失败 "初始化-手机登录入口", "app手机登录|手机登录1|手机登录2|验证码登录"
        End If
    ElseIf 等待命中图 <> "验证码登录" Then
        Tap x,y
        Delay 500
    End If

    必须等待界面 54,136,333,253,"验证码登录",12,250,2,"重启酷狗","初始化-验证码登录页"

    临时 = xdpub.元素查找S({"text":"同意"})
    If 临时 Then xdpub.元素点击(临时,300)
    Delay 300
    Tap 290,333
    Delay 500
    run code
End Function
