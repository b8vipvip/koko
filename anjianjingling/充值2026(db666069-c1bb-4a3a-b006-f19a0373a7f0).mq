                Delay 1500
                Exit do
            End If
        Next
        Delay 200
    loop
    
   
    run (code)
End Function 
Function web端登录() 
    TracePrint "登录web"
    KillApp via
    Delay 500
    RunApp via
    Delay 500
    Do
        找图 0,0,0,0,"via首开同意"
        If x > 0 Then 
            Delay 500
            Tap x, y
            Delay 500
               
        End If
        Delay 200
        找图 0,0,0,0,"via首页"
        If x > 0 Then 
            Delay 500
            Exit Do
               
        End If
        Delay 200
    loop
    rem 重进url
    zm.OpenURL url_dl
    Delay 2000
    '选择登录方式
    do
        For 15
            
            找图 0,0,0,0,"via手机登录"
            If x > 0 Then 
                Delay 500
                Tap x+15,y+15
                Delay 500
                Exit Do
            End If
            Delay 500
            找图 0,0,0,0,"via手机号登陆2"
            If x > 0 Then 
                Delay 500
                Tap x+15,y+15
                Delay 500
                Exit Do
            End If
            Delay 500
            找图 0,0,0,0,"via首开同意"
            If x > 0 Then 
                Delay 500
                Tap x, y
                Delay 500
                goto 重进url
            End If
        Next
        Goto 重进url
        TracePrint "重新打开url"
    Loop
    
    Delay 500 
    Do
        For 15
            Call 找图(0,0,0,0, "via手机号登陆")
            If x > 0 Then 
                Exit Do
            End If
            Delay 200
             Call 找图(0,0,0,0, "via登陆界面")
            If x > 0 Then 
                Exit Do
            End If
            Delay 200
            找图 0,0,0,0,"via手机登录"
            If x > 0 Then 
                Delay 500
                Tap x+15,y+15
                Delay 500
            End If
            找图 0,0,0,0,"via手机号登陆2"
            If x > 0 Then 
                Delay 500
                Tap x+15,y+15
                Delay 500
            End If
            Delay 200
        Next
        Delay 100
        KillApp via
        Delay 500
        goto 重进url
    Loop
    Do
        For 5
            Call 找图(0,0,0,0, "via登陆同意")
            If x > 0 Then 
                Delay 500
                '同意打钩
                Tap x+15,y+8
                Delay 200
                Tap 177,290
                Exit Do
            End If
        Next
        Delay 100
        KillApp via
        Delay 500
        goto 重进url
    Loop
    rem 等待登录
    Delay 200
    Tap 195,301
    Delay 300
    InputText 手机号
    Delay 300
    Tap 226,398
    Delay 300
    InputText 验证码
    '点登录
    Tap 358,560
    Delay 1000
    '是否已登录成功
    Delay 1000
    Do
        For 35
            Call 找图(0,0,0,0, "via多账户")
            If x > 0 Then 
                TracePrint "有多账户"
                web多账户()
                Exit do
            End If
            Delay 200 
            找图 0, 0, 0, 0, "via价格界面"                
            If x > 0 Then 
                TracePrint "via价格界面"
                goto 确认账号
            End If
            Delay 200 
            找图 0, 0, 0, 0, "via价格界面2"                
            If x > 0 Then 
                TracePrint "进入web价格界面"
                goto 确认账号
            End If
            Delay 200 
            找图 0, 0, 0, 0, "via价格界面3"                
            If x > 0 Then 
                TracePrint "进入web价格界面"
                goto 确认账号
            End If
            Delay 200 
            找图 0, 0, 0, 0, "via价格界面5"                
            If x > 0 Then 
                TracePrint "进入web价格界面"
                goto 确认账号
            End If
            Delay 100
            TracePrint "没找到价格"
            Call 找图(13,254,696,643,"via验证码错")
            If x > 0 Then 
                TracePrint "验证码失效"
                验证码1 = False
                Exit Function
            End If
            Call 找图(13,254,696,643,"web登录失败")
            If x > 0 Then 
                TracePrint "验证码失效"
                验证码1 = False
                Exit Function
            End If 
            TracePrint "没找到验证码失效"
            Call 找图(13,254,696,643,"via验证码错2")
            If x > 0 Then 
                TracePrint "验证码错误"
                验证码1 = False
                
                Delay 200
                
                Exit Function
            End If
            找图 0,0,0,0,"via手机号为空"
            If x > 0 Then 
                goto 重进url	
            End If
            找图 0,0,0,0,"via验证码为空"
            If x > 0 Then 
                goto 重进url	
            End If
            找图 0,0,0,0,"home"
            If x > 0 Then 
                goto 重进url	
            End If
            
            Delay 500
        Next
        web多账户()
    Loop
    
    Rem 确认账号
    run (code)
End Function
Function web多账户()
    Do
        For 5
            Call 找图(0,0,0,0, "via多账户")
            If x > 0 Then 
                TracePrint "有多账户"
                Exit do
            End If
        Next
        Exit Function
    Loop
    Call 找图(0,0,0,0, "via多账户")
    If x > 0 Then 
        TracePrint "自动选账户"	
        If 多账户 = "zh1" Then 
            Delay 200
            Tap 300,535
        ElseIf 多账户 = "zh2" Then 
            Delay 200
            Tap 300,735
        ElseIf 多账户 = "zh3" Then 
            Delay 200
            Tap 300,935
        End If
    Else 
        TracePrint "没有多账户,直接跳过选择"
    End If
    run (code)
End Function
Function web端充值(guige)
    webcz=1
    rem 重新打开
    zm.OpenURL url_vip
    Delay 1000
    Do
        For 3
            找图 0, 0, 0, 0, "via价格界面"                
            If x > 0 Then 
                TracePrint "via价格界面"
                Exit Do
            End If
            Delay 200 
