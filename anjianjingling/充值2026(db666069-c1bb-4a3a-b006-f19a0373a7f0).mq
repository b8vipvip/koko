            If x > 0 Then 
                TracePrint "via秒杀券页面"
                
                Exit Do          
            End If
            Delay 200
        next 
        zm.OpenURL url_jyq
        Delay 2000
    Loop
    Do
        For 10
            找图 0,0,0,0, "via9元券"
            If x > 0 Then 
                TracePrint "找到web9元券"
                Exit Do          
            End If
