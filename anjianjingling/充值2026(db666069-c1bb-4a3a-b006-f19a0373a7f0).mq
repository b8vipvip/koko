                If find=True Then 
                    TracePrint "选择支付宝"
                    tap tx,ty
                    Delay 300
                
                End If
                找图 0,0,0,0, "web开通"
                If find=True Then 
               
                    tap tx,ty
                    Delay 1000
                End If
                找色 8, 727, 119, 851, "D89235|D9953A"
                If find=True Then 
                    TracePrint "续费选项弹出"
                    Tap 94, 771
                    Delay 300
                End If
                Delay 100
            Next
            Delay 100
        loop
        Delay 1000
